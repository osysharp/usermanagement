namespace Osysharp.UserManagement;

using Osysharp.Identity;

// API KEYS — how a program (a teammate's script, an integration tool) calls the app's API as somebody. A people manager
// issues one to a person; the key is shown ONCE, to the manager who issued it, and only its hash is kept — on the
// person's account, in one of its two key slots (`Principal.ApiKeyHash` / `ApiKeyHash2`, so a key can be replaced with
// no moment when neither works). Every request that presents it acts as that person and nobody else, under the app's
// own rules. A manager revokes it, and the next request that presents it is refused.
//
// ⚑ A KEY IS AN ACCESS CHANGE. Issuing and revoking one are recorded as `AccessChange`s — who, to whom, when, why — and
//   applied by their run in the same commit, as every other change to somebody's access is. Deactivating a person
//   revokes every key they hold.

/// One API key a people manager issued — whose it is, what it is for, who issued it and when, how it ends, and whether
/// it is still in use. The key itself is never kept; its hash is on the holder's account while it is valid.
///
/// SECURITY-INVARIANT(api-keys-are-issued-and-revoked-by-people-managers-alone): a key is put on an account, and taken
/// off one, ONLY by the run of an `AccessChange` a people manager (`ManagesPeople`) recorded in their own name — never
/// by the holder or anybody else, and never readable afterwards (only its hash is kept, and nobody reads it). A key
/// acts as its holder and nobody else; a revoked key — and every key of a deactivated account — is refused from the
/// next request on. Guarded by tests/api-keys.test.osy.
public entity ApiKey {
  /// Whose key it is — every request that presents it acts as them.
  [Required] Principal Holder;
  /// What it is for, in the issuer's words — "Zapier", "Nightly export".
  [Required, MaxLength(100)] string Name;
  [Required] Principal IssuedBy;
  DateTime IssuedAt = DateTime.UtcNow;
  /// The last four characters of the key's random part (never of a scope's `~names`) — enough to match it by eye, too few to use.
  [MaxLength(10)] string Ending = "";
  /// The tool sets the key was minted for (`planner,releases`) — it reaches only those, on the app's tool server and its
  /// REST API; "" for a key that reaches everything its holder may.
  [MaxLength(100)] string Tools = "";
  /// Which of the holder's two key slots holds it — 1 or 2; 0 until its access change is applied.
  int Slot = 0;
  /// The key's hash, from the moment it is issued until its run puts it on the account; then null. Nobody reads it.
  [MaxLength(255)] string? PendingHash;
  DateTime? RevokedAt;
  Principal? RevokedBy;
  /// When the key stops working (UTC) — it is refused from then on, on the app's tool server and its REST API alike; null for
  /// a key with no end of its own. The instant is part of the key and of its hash, so nobody moves it.
  DateTime? ExpiresAt;

  security {
    // The managers read every key; a person reads the keys they hold.
    allow read when ManagesPeople || IsAuthenticated where Holder == user;
    allow read when ManagesPeople;
    // …and an actor the app lets issue keys (`IssuesApiKeys`) reads the ones it issued.
    allow read when IssuesApiKeys where IssuedBy == user;
    // A manager issues a key — or an actor the app lets issue them — in their own name. Nobody edits or deletes one: its run
    // writes it.
    allow create when ManagesPeople;
    allow create when IssuesApiKeys;
    deny create where IssuedBy != user;
    // Nobody reads the pending hash but the run that moves it onto the account.
    deny read PendingHash when user != Actor.Of<AccessChanger>();
    // …its access change's run puts it on the account (its slot, the hash moved off) and takes it off.
    allow read when user == Actor.Of<AccessChanger>();
    allow update Slot, PendingHash, RevokedAt, RevokedBy when user == Actor.Of<AccessChanger>();
  }
}

/// Which of the app's own actors may issue API keys sealed for a host (`IssueApiKeySealedForAsActor`) — none, until the app
/// says so for its own actor: `policy IssuesApiKeys => user == Actor.Of<ReviewKeys>();`. As the
/// identity kit's `KeepsApiKeys` is granted to this kit's run, one actor at a time.
[Extensible] virtual policy IssuesApiKeys => false;

/// What issuing a key answers — the key, shown ONCE, and the record of it.
public class IssuedApiKey {
  public Guid Id;
  /// The key itself — `pk_…`. Give it to the program now: it is never shown again.
  public string Key = "";
}

/// Issue `person` a new API key named `name` (what it is for). Answers the key — shown ONCE — and its record. Refused when
/// the person is deactivated, or already holds two keys (revoke one first). `tools` (`"planner,releases"`) mints a key that
/// reaches only those tool sets of the app's tool server; "" a key that reaches everything its holder may. Committed.
/// Only a people manager calls it — anybody else is refused before anything is minted, so the mint's refusal (the names a key
/// may carry, or the organization's cap) is never said to them.
/// `expiresIn` (`TimeSpan.FromHours(2)`) mints a key that stops working that long after it is issued; null, one with no end of
/// its own.
[Authorize(ManagesPeople)]
public IssuedApiKey IssueApiKey(Principal person, string name, string reason = "", string tools = "", TimeSpan? expiresIn = null) {
  var me = Session.CurrentUser;
  if (me == null) { throw new NotAuthorized("Sign in to issue an API key."); }
  var shown = name.Trim();
  if (shown == "") { throw new ValidationException("Say what the key is for — it is how you will recognise it in the list."); }
  if (shown.Length > 100) { shown = shown.Substring(0, 100); }
  if (!person.IsActive) { throw new ValidationException("This account is deactivated — reactivate it before issuing it a key."); }
  if (ApiKey.Count(k => k.Holder == person && k.Slot > 0 && k.RevokedAt == null) >= 2) {
    throw new ValidationException("This account already holds two keys — revoke one before issuing another.");
  }
  var scope = tools.Trim();
  var key = "";
  if (expiresIn == null) { key = scope == "" ? Security.NewApiKey() : Security.NewApiKey(Text.Split(scope, ",")); }
  else { key = scope == "" ? Security.NewApiKey(expiresIn: expiresIn!.Value) : Security.NewApiKey(Text.Split(scope, ","), expiresIn: expiresIn!.Value); }
  // `pk_…[~tools][!expiry]` — the tool sets and the random part, never the expiry's digits, are what the list shows.
  var plain = key.Contains("!") ? key.Substring(0, key.IndexOf("!")) : key;
  var sets = plain.Contains("~") ? plain.Substring(plain.IndexOf("~") + 1) : "";
  var secret = plain.Contains("~") ? plain.Substring(0, plain.IndexOf("~")) : plain;
  DateTime? ends = expiresIn == null ? null : DateTime.UtcNow.Add(expiresIn!.Value);
  var made = new ApiKey { Holder = person, Name = shown, IssuedBy = me!, IssuedAt = DateTime.UtcNow, ExpiresAt = ends,
                          Ending = "…" + secret.Substring(secret.Length - 4), Tools = sets, PendingHash = Security.HashApiKey(key) };
  var change = RecordKeyChange(person, AccessChangeKind.ApiKeyIssued, made, reason);
  // The run puts the hash on the account in the same commit — or refuses (a key this page never issued fills both slots),
  // or could not run: in either case the key it would have been is worthless and is not handed out.
  ThrowUnlessApplied(change.Id, "The key was not issued.");
  return new IssuedApiKey { Id = made.Id, Key = key };
}

/// What issuing a key SEALED for a host answers — the record of it, and the key as fcs1 text only that host opens. The key
/// itself was never an Osy# value: it was minted, hashed and sealed inside the runtime (`Security.NewApiKeySealedFor`).
public class IssuedSealedApiKey {
  public Guid Id;
  /// The key sealed for the host — `fcs1.…`, bound to the host's label, `kind` and this record's id (the fcs1 `name`).
  public string Sealed = "";
}

/// Issue `person` a new API key named `name`, SEALED for the host row `to` (a row whose entity declares `[SealRecipient]`), so
/// the key is never shown to anybody — not to the manager, not to this code: only the host's private key opens it. `kind`
/// is the label the host opens it as, `why` is recorded with the seal (`SecretUse`), `reason` with the access change. The
/// fcs1 `name` is the record's id. Otherwise exactly `IssueApiKey`: the same access change, run and applied in the same
/// commit, the same two key slots, the same refusals. `tools` and `expiresIn` as there. Committed.
[Authorize(ManagesPeople)]
public IssuedSealedApiKey IssueApiKeySealedFor(Principal person, string name, Entity to, string kind, string why,
                                               string reason = "", string tools = "", TimeSpan? expiresIn = null) {
  var me = Session.CurrentUser;
  if (me == null) { throw new NotAuthorized("Sign in to issue an API key."); }
  return IssueSealed(person, me!, name, to, kind, why, reason, tools, expiresIn);
}

/// `IssueApiKeySealedFor`, run by one of the app's own actors the app lets issue keys (`IssuesApiKeys`) — a key minted from
/// server code (a review session's), recorded in the actor's name. Nobody signed in as a person calls it.
[Authorize(IssuesApiKeys)]
public IssuedSealedApiKey IssueApiKeySealedForAsActor(Principal person, string name, Entity to, string kind, string why,
                                                      string reason = "", string tools = "", TimeSpan? expiresIn = null) {
  var me = Session.CurrentUser;
  if (me == null) { throw new NotAuthorized("Only an actor the app lets issue keys runs this."); }
  return IssueSealed(person, me!, name, to, kind, why, reason, tools, expiresIn);
}

IssuedSealedApiKey IssueSealed(Principal person, Principal me, string name, Entity to, string kind, string why,
                               string reason, string tools, TimeSpan? expiresIn) {
  var shown = name.Trim();
  if (shown == "") { throw new ValidationException("Say what the key is for — it is how you will recognise it in the list."); }
  if (shown.Length > 100) { shown = shown.Substring(0, 100); }
  if (!person.IsActive) { throw new ValidationException("This account is deactivated — reactivate it before issuing it a key."); }
  if (ApiKey.Count(k => k.Holder == person && k.Slot > 0 && k.RevokedAt == null) >= 2) {
    throw new ValidationException("This account already holds two keys — revoke one before issuing another.");
  }
  var scope = tools.Trim();
  List<string> sets = scope == "" ? [] : Text.Split(scope, ",").ToList();
  var made = new ApiKey { Holder = person, Name = shown, IssuedBy = me, IssuedAt = DateTime.UtcNow };
  var minted = expiresIn == null
    ? Security.NewApiKeySealedFor(sets, to: to, kind: kind, why: why, name: made.Id.ToString())
    : Security.NewApiKeySealedFor(sets, to: to, kind: kind, why: why, name: made.Id.ToString(), expiresIn: expiresIn!.Value);
  made.Ending = "…" + minted.Ending;
  made.Tools = minted.Tools;
  made.ExpiresAt = minted.ExpiresAt;
  made.PendingHash = minted.Hash;
  var change = RecordKeyChange(person, AccessChangeKind.ApiKeyIssued, made, reason);
  // As `IssueApiKey`: a change its run did not apply leaves the key worthless, and the sealed text is not handed out.
  ThrowUnlessApplied(change.Id, "The key was not issued.");
  return new IssuedSealedApiKey { Id = made.Id, Sealed = minted.Sealed };
}

/// Revoke `key` — the next request that presents it is refused. Committed.
public AccessChange RevokeApiKey(ApiKey key, string reason = "") {
  var change = RecordKeyChange(key.Holder, AccessChangeKind.ApiKeyRevoked, key, reason);
  ThrowUnlessApplied(change.Id, "The key was not revoked.");
  return change;
}

/// The change as its run left it — refused or expired, and why, is said to the person who asked; a change its run did not apply (the run
/// could not run: it is retried, and nothing it would change has changed) is said as not made, so nobody is told a key was
/// issued or revoked, or anything else was done, that was not.
void ThrowUnlessApplied(Guid changeId, string otherwise) {
  var applied = AccessChange.Single(c => c.Id == changeId);
  if (applied.State == AccessChangeState.Refused || applied.State == AccessChangeState.Expired) { throw new ValidationException(applied.Refusal ?? otherwise); }
  if (applied.State != AccessChangeState.Applied) { throw new ValidationException(otherwise + " Its change could not be applied — try again, or ask whoever runs the app."); }
}

/// The name 0.13 gave `ThrowUnlessApplied`, kept so code written against it compiles: it says what that one says — a change
/// not applied, for whatever reason, is never passed over as made.
void ThrowIfRefused(Guid changeId, string otherwise) { ThrowUnlessApplied(changeId, otherwise); }

AccessChange RecordKeyChange(Principal person, AccessChangeKind kind, ApiKey key, string reason) {
  var me = Session.CurrentUser!;
  var problem = AccessProblem(person, me, kind, null, null, reason);
  if (problem != "") { throw new ValidationException(problem); }
  var made = new AccessChange { Person = person, By = me, Kind = kind, Key = key, Reason = reason.Trim() };
  UnitOfWork.Commit();
  return made;
}

/// "" when a key change can be applied, else why not — a key to issue is the person's and they may sign in; a key to
/// revoke is still valid. Asked by the run, which reads the account as its actor (`AccessChanger`).
string ApiKeyProblem(AccessChange change) {
  var k = change.Key;
  if (k == null) { return "Say which key."; }
  if (k!.Holder.Id != change.Person.Id) { return "That key is somebody else's."; }
  if (change.Kind == AccessChangeKind.ApiKeyIssued) {
    if (!change.Person.IsActive) { return "This account is deactivated — reactivate it before issuing it a key."; }
    if (k!.Slot != 0 || k!.PendingHash == null) { return "That key was already issued."; }
    if (change.Person.ApiKeyHash != null && change.Person.ApiKeyHash2 != null) {
      return "This account already holds two keys — revoke one before issuing another.";
    }
    return "";
  }
  if (k!.RevokedAt != null || k!.Slot == 0) { return "That key is not in use."; }
  return "";
}

/// Put an issued key's hash on its holder's account (as the run's actor, `AccessChanger`), in the first free slot.
void ApplyKeyIssued(AccessChange change) {
  var k = change.Key!;
  var p = change.Person;
  if (p.ApiKeyHash == null) { p.ApiKeyHash = k.PendingHash; p.ApiKeyUsedAt = null; k.Slot = 1; }
  else { p.ApiKeyHash2 = k.PendingHash; p.ApiKey2UsedAt = null; k.Slot = 2; }
  k.PendingHash = null;
}

/// Take a key off its holder's account — its slot emptied — and record who revoked it, when.
void TakeKeyOff(ApiKey k, Principal by) {
  var p = k.Holder;
  if (k.Slot == 1) { p.ApiKeyHash = null; }
  if (k.Slot == 2) { p.ApiKeyHash2 = null; }
  k.RevokedAt = DateTime.UtcNow;
  k.RevokedBy = by;
}

/// Every key `person` holds, taken off — what deactivating an account does, so a key cannot outlive the person's access.
[SuppressWarning("cost-unbounded-read")]   // one person's live keys
void TakeEveryKeyOff(Principal person, Principal by) {
  foreach (var k in ApiKey.Where(x => x.Holder == person && x.RevokedAt == null && x.Slot > 0).ToList()) { TakeKeyOff(k, by); }
  // A key minted outside this kit (`osyrin app user apikey generate`) has no record, and goes too.
  person.ApiKeyHash = null;
  person.ApiKeyHash2 = null;
}

// ── what the page shows ─────────────────────────────────────────────────────────────────────────────────────────────

/// One key as the page lists it.
public class ApiKeyLine {
  public Guid Id;
  public string Name = "";
  public string Holder = "";
  /// The account it acts as — what a page matches against the integrations it lists.
  public Guid HolderId;
  public string Ending = "";
  /// The tool sets the key reaches (`planner,releases`); "" when it reaches everything its holder may.
  public string Tools = "";
  /// The name as the table shows it — with the tool sets of a key minted for some: "Nightly export · tools: planner".
  public string Named = "";
  public string Issued = "";
  public string LastUsed = "";
  public bool Revoked;
  public string RevokedWords = "";
  /// Who issued it, and the day — the table's own columns (`Issued` says both in one line).
  public string IssuedBy = "";
  public string IssuedOn = "";
  /// When it was last presented, in words ("3 h ago"), "Never" — and "" for a revoked key.
  public string Used = "";
}

/// The keys, newest first: those in use, then (when `withRevoked`) those revoked. `now` words the times.
public List<ApiKeyLine> ApiKeyLines(DateTime now, bool withRevoked = false) {
  List<ApiKeyLine> lines = [];
  var keys = ApiKey.Where(k => k.Slot > 0 && (withRevoked || k.RevokedAt == null))
                   .OrderByDescending(k => k.IssuedAt).Take(200).ToList();
  foreach (var k in keys) {
    var used = k.Slot == 1 ? k.Holder.ApiKeyUsedAt : k.Holder.ApiKey2UsedAt;
    lines.Add(new ApiKeyLine {
      Id = k.Id, Name = k.Name, Holder = NameOf(k.Holder), HolderId = k.Holder.Id, Ending = k.Ending,
      Tools = k.Tools, Named = k.Tools == "" ? k.Name : k.Name + " · tools: " + k.Tools,
      Issued = $"Issued by {NameOf(k.IssuedBy)} · {k.IssuedAt:d MMM yyyy}",
      LastUsed = k.RevokedAt != null ? "" : used == null ? "Never used" : "Last used " + Ago(used.Value, now),
      IssuedBy = NameOf(k.IssuedBy), IssuedOn = $"{k.IssuedAt:d MMM yyyy}",
      Used = k.RevokedAt != null ? "" : used == null ? "Never" : Ago(used.Value, now),
      Revoked = k.RevokedAt != null,
      RevokedWords = k.RevokedAt == null ? "" : $"Revoked {k.RevokedAt:d MMM yyyy}" + (k.RevokedBy != null ? " by " + NameOf(k.RevokedBy!) : ""),
    });
  }
  return lines;
}

/// Who a key can be issued to — the people list's active people and the active integrations, by name.
public List<Principal> KeyHolders() {
  var directory = App.Setting<PeopleSetup>().Directory;
  var listed = directory.Listed();
  var hidden = NotListed(directory);
  var people = listed != null
    ? listed.Where(p => p.IsActive && !hidden.Contains(p.Id)).OrderBy(p => p.DisplayName).Take(PeopleShown()).ToList()
    : Everybody("", false, hidden);
  var ids = people.Select(p => p.Id).ToList();
  // The integrations as well, whoever the directory lists — a program is not a person on the list, and takes keys.
  foreach (var i in Integration.Where(x => x.IsActive && !ids.Contains(x.Id)).OrderBy(x => x.DisplayName).Take(PeopleShown()).ToList()) {
    people.Add(i);
  }
  return people.OrderBy(p => p.DisplayName).ToList();
}

/// The tool sets and catalogs a key may be issued for here, by name — the app's tool server's, and under the organization's
/// cap on what a key may carry (`mcp.toolSets`) only the cap's; none when the app has no tool server, or the rule cannot be
/// read. What the key page offers to tick; `IssueApiKey(…, tools)` is still refused a key the cap forbids. A people manager's
/// to read, as the page is: anybody else is refused, and learns neither the names nor the cap.
[Authorize(ManagesPeople)]
public List<string> KeyToolSets() { return Security.ApiKeyToolSets(); }

string NameOf(Principal p) { return p.DisplayName != "" ? p.DisplayName : p.Email; }

/// "just now", "4 min ago", "3 h ago", "2 days ago", "12 Mar".
string Ago(DateTime at, DateTime now) {
  var span = now - at;
  if (span.TotalMinutes < 1) { return "just now"; }
  if (span.TotalMinutes < 60) { return (int)Math.Floor(span.TotalMinutes) + " min ago"; }
  if (span.TotalHours < 24) { return (int)Math.Floor(span.TotalHours) + " h ago"; }
  if (span.TotalDays < 14) { var d = (int)Math.Floor(span.TotalDays); return d == 1 ? "yesterday" : d + " days ago"; }
  return at.ToString("d MMM");
}
