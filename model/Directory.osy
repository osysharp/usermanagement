// What the user manager shows — one row per person, and one person in full. Read as the manager: what they may read of
// each person, and the app roles they hold (`partial entity RoleGrant`, below).

namespace Osysharp.UserManagement;

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Organizations;
using Osysharp.Invitations;

// ⚠ THE APP GRANTS ITS MANAGERS THE READ OF WHO HOLDS WHICH ROLE — the one thing the user manager needs that
//   Osysharp.Identity does not grant (each person reads only their own roles there):
//     partial entity RoleGrant { security { allow read when ManagesPeople; } }
//   One line, in the app: who reads another kit's records is the app's to say. Reading only: every CHANGE goes through `AccessChange`, so an app that also grants create/delete on RoleGrant opens a
//   second, unrecorded way to change access.

/// One person, as the people list shows them.
public class PersonRow {
  public Guid Id;
  public string Name = "";
  public string Email = "";
  public bool Active = true;
  /// Their address was proven — a message sent to it was received and acted on.
  public bool Verified = false;
  /// Two-step sign-in is on (an authenticator app, or a texted step).
  public bool SecondFactorOn = false;
  public DateTime? LastSignIn;
  /// The app roles they hold, by the names the app gives them, comma-separated.
  public string Roles = "";
  /// The organisations they are in, comma-separated.
  public string Organizations = "";
}

/// How many people the list shows at most — the first by name; a search narrows it.
public int PeopleShown() { return 500; }

/// Whether the signed-in person may invite somebody — the app's `MayInvite`, answered on the SERVER, for the caller
/// alone. The people page asks it once, so the app's answer may read any table it likes (a role's permissions kept as
/// rows); a policy reflected onto a control could read only the caller's own rows. It only decides whether the invite
/// control is SHOWN: sending, revoking and resending are refused by the Invitations kit's rules whatever it said.
public bool MayInvitePeople() { return MayInvite; }

/// Everybody the directory lists, or those whose name or address contains `search`, by name — with what each holds. The
/// first `PeopleShown()`; the roles and organisations are read for those people only.
public List<PersonRow> PeopleList(string search = "", bool includeInactive = true) {
  var q = search.Trim().ToLower();
  var directory = App.Setting<PeopleSetup>().Directory;
  var listed = directory.Listed();
  var hidden = directory.Hidden();
  var people = listed != null
    ? listed.Where(p => !hidden.Contains(p.Id) && (includeInactive || p.IsActive) && (q == "" || p.Email.ToLower().Contains(q) || p.DisplayName.ToLower().Contains(q)))
        .OrderBy(x => x.DisplayName).ThenBy(x => x.Email).Take(PeopleShown()).ToList()
    : Everybody(q, includeInactive, hidden);
  var ids = people.Select(p => p.Id).ToList();
  var grants = PeopleGrantsOf(ids);
  var memberships = PeopleMembershipsOf(ids);
  List<PersonRow> rows = [];
  foreach (var p in people) {
    var roles = "";
    foreach (var g in grants) {
      if (g.Member.Id != p.Id) { continue; }
      var label = RoleLabel(g.Role);
      if (label == "") { continue; }
      roles = roles == "" ? label : roles + ", " + label;
    }
    var orgs = "";
    foreach (var m in memberships) {
      if (m.Member.Id != p.Id) { continue; }
      orgs = orgs == "" ? m.Organization.Name : orgs + ", " + m.Organization.Name;
    }
    var on = false;
    if (p is User u) { on = u.SecondFactorOnAt != null || u.SmsSecondStep; }
    rows.Add(new PersonRow {
      Id = p.Id, Name = p.DisplayName != "" ? p.DisplayName : p.Email, Email = p.Email, Active = p.IsActive,
      Verified = p.EmailVerifiedAt != null, SecondFactorOn = on, LastSignIn = p.LastLoginAt, Roles = roles, Organizations = orgs,
    });
  }
  return rows;
}

/// Everybody with an account whose name or address contains `q` ("" for all), by name — the first `PeopleShown()` — but
/// for the accounts `hidden` names, which the database leaves out.
List<Principal> Everybody(string q, bool includeInactive, List<Guid> hidden) {
  if (q == "") {
    return includeInactive
      ? Principal.Where(x => !hidden.Contains(x.Id)).OrderBy(x => x.DisplayName).ThenBy(x => x.Email).Take(PeopleShown()).ToList()
      : Principal.Where(x => x.IsActive && !hidden.Contains(x.Id)).OrderBy(x => x.DisplayName).ThenBy(x => x.Email).Take(PeopleShown()).ToList();
  }
  return includeInactive
    ? Principal.Where(x => !hidden.Contains(x.Id) && (x.Email.ToLower().Contains(q) || x.DisplayName.ToLower().Contains(q)))
        .OrderBy(x => x.DisplayName).ThenBy(x => x.Email).Take(PeopleShown()).ToList()
    : Principal.Where(x => x.IsActive && !hidden.Contains(x.Id) && (x.Email.ToLower().Contains(q) || x.DisplayName.ToLower().Contains(q)))
        .OrderBy(x => x.DisplayName).ThenBy(x => x.Email).Take(PeopleShown()).ToList();
}

/// Everybody with an account whose name or address contains `q` ("" for all), by name, hiding nobody. Kept from 0.7.0, so an
/// app written against it still compiles.
List<Principal> Everybody(string q, bool includeInactive) {
  return Everybody(q, includeInactive, new List<Guid>());
}

/// The app roles the people `ids` hold.
[SuppressWarning("cost-unbounded-read")]   // the roles of the people the list already took — PeopleShown() at most
List<RoleGrant> PeopleGrantsOf(List<Guid> ids) {
  if (ids.Count == 0) { return []; }
  return RoleGrant.Where(g => ids.Contains(g.Member.Id)).ToList();
}

/// The organisations the people `ids` are active members of.
[SuppressWarning("cost-unbounded-read")]   // the memberships of the people the list already took — PeopleShown() at most
List<Membership> PeopleMembershipsOf(List<Guid> ids) {
  if (ids.Count == 0) { return []; }
  return Membership.Where(m => m.IsActive && ids.Contains(m.Member.Id)).Include(m => m.Organization).ToList();
}

/// A role a person holds, as the detail shows it.
public class HeldRole {
  public role? Role = null;
  public string Label = "";
  /// The organisation it is held in — "" for an app role.
  public string Organization = "";
  public Guid? OrganizationId;
  /// Whether a page may take it away — false for a role the app lists `Grantable = false` (it is named, never handed out).
  public bool Removable = true;
}

/// One app role a manager can give a person, as "Add role" lists it — every role the app offers across the app, with
/// whether the person already holds it.
public class RoleOffer {
  public role? Role = null;
  public string Label = "";
  public string Description = "";
  public bool Held = false;
}

/// One line of a person's access history, or of the app-wide trail.
public class AccessEvent {
  /// The record it reads from — the `AccessChange`, or the invitation somebody joined by. What a table's row is known by.
  public Guid Id;
  public DateTime At;
  /// The change in one sentence, the person included on the app-wide trail ("Granted Lead — Mo Haddad").
  public string What = "";
  public string By = "";
  public string Reason = "";
  /// The change alone ("Granted Lead") — the trail's "What" column, beside who it concerns.
  public string Change = "";
  /// Who it concerns — the person whose access it is; for an integration, who answers for it.
  public string Person = "";
  /// It was asked for and NOT made: a rule refused it, and `Refusal` says which.
  public bool Refused = false;
  public string Refusal = "";
}

/// One person in full — for the user manager's detail.
public class PersonDetail {
  public Guid Id;
  public string Name = "";
  public string Email = "";
  public bool Active = true;
  public bool Verified = false;
  public bool SecondFactorOn = false;
  public DateTime? SecondFactorSince;
  /// Whether the app requires two-step sign-in of them.
  public bool SecondFactorRequired = false;
  public bool SignsInWithPassword = false;
  /// A program, not a person (`Integration`): it never signs in, and acts through its API keys.
  public bool IsIntegration = false;
  public DateTime? LastSignIn;
  /// How many places they are signed in right now (other than the manager's own session).
  public int SignedIn = 0;
  public List<HeldRole> Roles = [];
  /// The offered app roles they do NOT hold — what a manager may grant them.
  public List<RoleOption> Grantable = [];
  /// Every app role the app offers, held or not — what "Add role" lists, so the whole of what can be given is in view.
  public List<RoleOffer> Offered = [];
  public List<AccessEvent> History = [];
}

/// `id` in full, as a people manager reads them.
[SuppressWarning("cost-unbounded-read")]   // one person's roles, organisation roles and the invitations they accepted
public PersonDetail PersonDetailOf(Guid id) {
  var p = Principal.Single(x => x.Id == id);
  var d = new PersonDetail {
    Id = p.Id, Name = p.DisplayName != "" ? p.DisplayName : p.Email, Email = p.Email, Active = p.IsActive,
    Verified = p.EmailVerifiedAt != null, LastSignIn = p.LastLoginAt, SignedIn = Security.SignedInElsewhere(p.Id),
  };
  if (p is User u) {
    d.SecondFactorOn = u.SecondFactorOnAt != null || u.SmsSecondStep;
    d.SecondFactorSince = u.SecondFactorOnAt;
    d.SecondFactorRequired = App.Setting<AccountsSetup>().SecondFactor.Required(u);
    d.SignsInWithPassword = true;
  }
  d.IsIntegration = p is Integration;
  foreach (var g in RoleGrant.Where(x => x.Member == p).ToList()) {
    var label = RoleLabel(g.Role);
    if (label != "") { d.Roles.Add(new HeldRole { Role = g.Role, Label = label, Removable = IsOfferedRole(g.Role, RoleScope.App) }); }
  }
  foreach (var r in MembershipRole.Where(x => x.Membership.Member == p && x.Membership.IsActive).Include(x => x.Membership.Organization).ToList()) {
    var label = RoleLabel(r.Role);
    d.Roles.Add(new HeldRole { Role = r.Role, Label = label != "" ? label : "Member",
                               Organization = r.Membership.Organization.Name, OrganizationId = r.Membership.Organization.Id });
  }
  foreach (var o in OfferedRoles(RoleScope.App)) {
    if (o.Role == null) { continue; }
    var held = false;
    foreach (var h in d.Roles) { if (h.Organization == "" && h.Role != null && h.Role.Value == o.Role.Value) { held = true; } }
    if (!held) { d.Grantable.Add(o); }
    d.Offered.Add(new RoleOffer { Role = o.Role, Label = o.Label, Description = o.Description, Held = held });
  }
  foreach (var c in AccessChange.Where(x => x.Person == p).Include(x => x.By).OrderByDescending(x => x.At).Take(50).ToList()) {
    d.History.Add(new AccessEvent { Id = c.Id, At = c.At, What = Describe(c), Change = Describe(c), Person = d.Name,
                                    By = c.By.DisplayName != "" ? c.By.DisplayName : c.By.Email, Reason = c.Reason,
                                    Refused = c.State == AccessChangeState.Refused, Refusal = c.Refusal ?? "" });
  }
  foreach (var i in Invitation.Where(x => x.AcceptedBy == p).Include(x => x.InvitedBy).ToList()) {
    d.History.Add(new AccessEvent { Id = i.Id, At = i.AcceptedAt ?? i.CreatedAt, What = "Joined by an invitation to " + InvitedInto(i)
      + (i.Role != null && RoleLabel(i.Role.Value) != "" ? " as " + RoleLabel(i.Role.Value) : ""),
      By = i.InvitedBy.DisplayName, Reason = "" });
  }
  d.History = d.History.OrderByDescending(e => e.At).ToList();
  return d;
}

/// A change in words — "Granted Admin", "Removed from Acme".
public string Describe(AccessChange c) {
  var role = c.Role == null ? "" : RoleLabel(c.Role.Value);
  var org = c.Organization == null ? "" : c.Organization!.Name;
  if (c.Kind == AccessChangeKind.RoleGranted) { return "Granted " + role; }
  if (c.Kind == AccessChangeKind.RoleRevoked) { return "Revoked " + role; }
  if (c.Kind == AccessChangeKind.OrganizationRoleGranted) { return $"Granted {role} at {org}"; }
  if (c.Kind == AccessChangeKind.OrganizationRoleRevoked) { return $"Revoked {role} at {org}"; }
  if (c.Kind == AccessChangeKind.JoinedOrganization) { return "Added to " + org; }
  if (c.Kind == AccessChangeKind.LeftOrganization) { return "Removed from " + org; }
  if (c.Kind == AccessChangeKind.ApiKeyIssued && c.Key != null) { return $"Issued the API key “{c.Key!.Name}” {c.Key!.Ending}"; }
  if (c.Kind == AccessChangeKind.ApiKeyRevoked && c.Key != null) { return $"Revoked the API key “{c.Key!.Name}” {c.Key!.Ending}"; }
  if (c.Kind == AccessChangeKind.IntegrationAdded && org != "") { return $"Added the integration “{c.IntegrationName ?? ""}” as {role} at {org}"; }
  if (c.Kind == AccessChangeKind.IntegrationAdded && c.Role == null) { return $"Added the integration “{c.IntegrationName ?? ""}” with no role"; }
  if (c.Kind == AccessChangeKind.IntegrationAdded) { return $"Added the integration “{c.IntegrationName ?? ""}” as {role}"; }
  if (c.Kind == AccessChangeKind.IntegrationReassigned) { return $"Became the owner of the integration “{c.IntegrationName ?? ""}”"; }
  return c.Kind.Label;
}

/// The changes made to anybody's access, newest first — the app-wide trail.
public List<AccessEvent> AccessTrail(int take = 100) {
  List<AccessEvent> all = [];
  foreach (var c in AccessChange.Include(x => x.By).Include(x => x.Person).OrderByDescending(x => x.At).Take(take).ToList()) {
    var whom = c.Person.DisplayName != "" ? c.Person.DisplayName : c.Person.Email;
    // An integration's `Person` is who answers for it, not who it is.
    var what = c.Kind == AccessChangeKind.IntegrationAdded ? Describe(c) + ", owned by " + whom
             : c.Kind == AccessChangeKind.IntegrationReassigned ? $"Gave the integration “{c.IntegrationName ?? ""}” to {whom}"
             : Describe(c) + " — " + whom;
    all.Add(new AccessEvent { Id = c.Id, At = c.At, What = what, Change = Describe(c), Person = whom,
                              By = c.By.DisplayName != "" ? c.By.DisplayName : c.By.Email, Reason = c.Reason,
                              Refused = c.State == AccessChangeState.Refused, Refusal = c.Refusal ?? "" });
  }
  return all;
}

/// How many changes the access page reads at most, however often "Show more" is pressed — past it the page says it
/// shows the newest that many, and reads no more.
public int AccessTrailMost() { return 500; }
