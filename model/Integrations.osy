namespace Osysharp.UserManagement;

using Osysharp.Identity;
using Osysharp.Organizations;

// INTEGRATIONS — a program the app is used BY: Zapier, a nightly export, a partner's system. It is an account of its own,
// with a name, a person who answers for it, the roles it was given, and API keys — and nothing a person has: no mailbox,
// no password, no way to sign in. So what it does is recorded under its own name ("Zapier assigned the ticket"), never
// under a teammate's, and switching it off is one act that takes every key it holds with it.
//
// ⚑ ADDED LIKE ANY OTHER CHANGE TO ACCESS. A people manager records an `AccessChange` (`IntegrationAdded`) naming it, its
//   role (or none) and its owner; the change's run makes the account and grants the role in the same commit. Its keys are issued
//   and revoked as everybody's are (`IssueApiKey`, `RevokeApiKey`), and deactivating it (`Deactivate`) revokes them all.
//
// ⚑ HELD ACROSS THE APP, OR IN ONE ORGANISATION. Without `organization:` its role is an app role (a `RoleGrant`). With it,
//   the role is held in that organisation alone (a membership there and its `MembershipRole`) and the integration holds
//   no app role at all — an agent key for one customer, one team, one product, which reads only what that
//   organisation's members read. A role is given only where the app says it may be held (`RoleChoice.HeldIn`).
//
// ⚑ IT OUTLIVES ITS OWNER. Deactivating the person who answers for it ends their sessions and their keys, never the
//   integration's: a program the team depends on does not stop because somebody left. The page says "owner deactivated",
//   and a manager gives it to somebody who is here (`ReassignIntegration`), recorded like every other change to access.

/// A program that calls the app's API under its own name — never a person. It holds API keys and roles, and cannot sign
/// in: it has no password, and its address is one no mail is ever delivered to, kept only because every account has one.
///
/// SECURITY-INVARIANT(an-integration-never-signs-in): an `Integration` is never handed a session. No sign-in door of the
/// kits admits it — every one of them looks the account up as an `Osysharp.UserAccounts` `User`, which it is not — it holds
/// no password, and its address is unique, unguessable and undeliverable (`.invalid`), so no code, link or invitation can
/// reach it. It acts only through an API key a people manager issued it, and nobody — itself included, holding its own
/// key — edits it afterwards: a renamed integration would put another name on everything it has done. Guarded by
/// tests/integrations.test.osy (`an_integration_cannot_sign_in_by_any_door`, `an_integration_cannot_rename_itself`).
public entity Integration : Principal {
  /// The person who answers for it — who to ask what it is and whether it is still needed.
  [Required] Principal Owner;

  security {
    // Seen as every account is — its name is on what it does.
    allow read when IsAuthenticated || IsAuthenticator;
    // Made and changed by its access change's run alone (the system). Nobody edits it — a manager adds a new one
    // instead, and it cannot edit itself with its own key.
    deny update;
  }
}

/// The address an integration is given — every account has one, and this one reaches nobody: `.invalid` is a name the
/// internet reserves for exactly that (RFC 2606), and the random part makes it one nobody can guess or claim elsewhere.
string NewIntegrationAddress() {
  return "integration-" + Security.RandomHex(12) + "@integrations.invalid";
}

/// Add an integration called `name`, holding the role `r` (one the app offers) or none, answered for by `owner` (the
/// caller when not given). Without `organization` the role is held across the app; with it, the role is held in `organization` alone
/// and the integration holds no app role. Answers the integration — issue it a key next (`IssueApiKey`). Committed.
///
/// With NO role — `AddIntegration("Zapier")` — the integration is added holding none, anywhere: the account, its owner
/// and the record of its creation, and no `RoleGrant`, membership or `MembershipRole`. For an app whose own rules say
/// roles are given only by its own function: this kit owns the account and its keys, the app owns who holds what where,
/// and gives the integration its role by that function.
///
/// SECURITY-INVARIANT(an-integration-added-with-no-role-does-nothing-a-role-admits): an integration added with no role
/// is given NOTHING — no `RoleGrant`, no membership, no `MembershipRole` — so a key it holds authenticates as it and is
/// admitted by no rule that asks for a role or a membership: it reads and writes what a signed-in account holding
/// nothing does, until the app gives it a role. An organisation named with no role is refused. Guarded by
/// tests/integrations.test.osy (`an_integration_added_with_no_role_does_nothing_until_it_is_given_one`,
/// `an_integration_added_with_no_role_is_recorded_and_listed_as_holding_none`).
///
/// SECURITY-INVARIANT(an-integration-added-to-an-organisation-holds-no-app-role): an integration added with
/// `organization:` is given its role as a `MembershipRole` in that organisation and NOTHING ELSE — no `RoleGrant`, no
/// membership anywhere else — so a key it holds reads only what that organisation's members read; and a role is given
/// only where the app offers it to be held (`RoleChoice.HeldIn`): an app-wide role never inside an organisation, an
/// organisation's role never across the app. Guarded by tests/integrations.test.osy
/// (`an_integration_added_to_one_organisation_acts_with_its_role_there`,
/// `an_integration_added_to_one_organisation_reads_nothing_of_another`,
/// `an_integration_added_to_one_organisation_holds_no_app_role`,
/// `a_role_is_given_to_an_integration_only_where_the_app_says_it_is_held`).
public Integration AddIntegration(string name, role r, Principal? owner = null, string reason = "", Organization? organization = null) {
  return AddIntegrationHolding(name, r, owner, reason, organization);
}

/// Add an integration called `name` holding NO role — `AddIntegration("Zapier")` — answered for by `owner` (the caller
/// when not given). See the form above for what it is given (nothing) and why an app adds one this way.
public Integration AddIntegration(string name, Principal? owner = null, string reason = "", Organization? organization = null) {
  return AddIntegrationHolding(name, null, owner, reason, organization);
}

/// Both forms of `AddIntegration`: the role `r`, or none.
internal Integration AddIntegrationHolding(string name, role? r, Principal? owner, string reason, Organization? organization) {
  var me = Session.CurrentUser;
  if (me == null) { throw new NotAuthorized("Sign in to add an integration."); }
  var shown = name.Trim();
  if (shown == "") { throw new ValidationException("Name the integration — what it is, as you will recognise it in the list: “Zapier”."); }
  if (shown.Length > 100) { throw new ValidationException("Keep the name under 100 characters — it is what every record it makes is filed under."); }
  var answers = owner ?? me!;
  var problem = AccessProblem(answers, me!, AccessChangeKind.IntegrationAdded, r, organization, reason);
  if (problem != "") { throw new ValidationException(problem); }
  var made = new AccessChange { Person = answers, By = me!, Kind = AccessChangeKind.IntegrationAdded, Role = r,
                                Organization = organization, IntegrationName = shown, Reason = reason.Trim(),
                                At = DateTime.UtcNow };
  UnitOfWork.Commit();
  ThrowIfRefused(made.Id, "The integration was not added.");
  return AccessChange.Single(c => c.Id == made.Id).Integration!;
}

/// Give `integration` to `owner` to answer for — the person to ask what it is and whether it is still needed, typically
/// when the one who answered for it has left. Recorded as a change to access (`IntegrationReassigned`), so the trail says
/// who handed it over, to whom, and why; its keys and its role are untouched. Committed.
public AccessChange ReassignIntegration(Integration integration, Principal owner, string reason = "") {
  var me = Session.CurrentUser;
  if (me == null) { throw new NotAuthorized("Sign in to reassign an integration."); }
  var problem = AccessProblem(owner, me!, AccessChangeKind.IntegrationReassigned, null, null, reason);
  if (problem == "") { problem = ReassignProblem(integration, owner); }
  if (problem != "") { throw new ValidationException(problem); }
  var made = new AccessChange { Person = owner, By = me!, Kind = AccessChangeKind.IntegrationReassigned,
                                Integration = integration, IntegrationName = integration.DisplayName,
                                Reason = reason.Trim(), At = DateTime.UtcNow };
  UnitOfWork.Commit();
  ThrowIfRefused(made.Id, "The integration was not reassigned.");
  return AccessChange.Single(c => c.Id == made.Id);
}

/// "" when `integration` can be given to `owner`, else why not: it must name an integration, and somebody new.
string ReassignProblem(Integration? integration, Principal owner) {
  if (integration == null) { return "Say which integration."; }
  if (integration!.Owner.Id == owner.Id) { return NameOf(owner) + " already answers for " + integration!.DisplayName + "."; }
  return "";
}

/// Make the integration a change names and give it its role, when it names one (as the system — its run): in the
/// change's organisation when it names one, and then nothing across the app; else across the app, telling the app the
/// role was given.
void MakeIntegration(AccessChange change) {
  var made = new Integration { Email = NewIntegrationAddress(), DisplayName = change.IntegrationName ?? "Integration",
                               Owner = change.Person, IsActive = true, Source = IdentitySource.Local };
  change.Integration = made;
  // Added holding no role: the account and nothing else — no grant, no membership, and the app is told of none.
  if (change.Role == null) { return; }
  var r = change.Role!.Value;
  if (change.Organization != null) {
    GrantIn(change.Organization!, made, r);
    return;
  }
  new RoleGrant { Member = made, Role = r };
  App.Setting<RolesSetup>().Events.Granted(made, r);
}

// ── what the page shows ─────────────────────────────────────────────────────────────────────────────────────────────

/// One integration as the page lists it.
public class IntegrationLine {
  public Guid Id;
  public string Name = "";
  public string Owner = "";
  /// Whether the person who answers for it can still sign in — an integration whose owner left keeps working, and the
  /// page says so, so a manager gives it to somebody who is here (`ReassignIntegration`).
  public bool OwnerActive = true;
  public string Roles = "";
  /// Whether it holds any role at all, across the app or in an organisation — named by the app or not. False for one
  /// added with no role and not yet given one: its keys are accepted and no rule that asks for a role admits it.
  public bool HoldsRole = false;
  public bool Active = true;
  public int Keys = 0;
}

/// The integrations, by name: those switched on first, then (when `withInactive`) those switched off.
public List<IntegrationLine> IntegrationLines(bool withInactive = false) {
  List<IntegrationLine> lines = [];
  var integrations = Integration.Where(x => withInactive || x.IsActive).Include(x => x.Owner).OrderBy(x => x.DisplayName).Take(200).ToList();
  // Their roles and live keys read once for the page, not once per integration.
  var ids = integrations.Select(i => i.Id).ToList();
  var grants = PeopleGrantsOf(ids);
  var held = OrganizationRolesOf(ids);
  var keys = new Dictionary<Guid, int>();
  if (ids.Count > 0) {
    foreach (var k in ApiKey.Where(k => ids.Contains(k.Holder.Id) && k.Slot > 0 && k.RevokedAt == null)
        .GroupBy(k => k.Holder.Id).Select(g => new IntegrationKeyCount { Holder = g.Key, Count = g.Count() }).ToList()) {
      keys[k.Holder] = k.Count;
    }
  }
  foreach (var i in integrations) {
    var roles = new List<string>();
    // A role the app gave by its own route and does not list among those it offers has no name here, and is still held.
    var holds = false;
    foreach (var g in grants.Where(x => x.Member.Id == i.Id)) {
      holds = true;
      var label = RoleLabel(g.Role);
      if (label != "") { roles.Add(label); }
    }
    // One held in an organisation is named with it — "Planner at Beta" — never as though it were held across the app.
    foreach (var h in held.Where(x => x.Membership.Member.Id == i.Id)) {
      holds = true;
      var label = RoleLabel(h.Role);
      if (label != "") { roles.Add(label + " at " + h.Membership.Organization.Name); }
    }
    lines.Add(new IntegrationLine { Id = i.Id, Name = i.DisplayName, Owner = NameOf(i.Owner), OwnerActive = i.Owner.IsActive, Roles = string.Join(", ", roles),
      HoldsRole = holds, Active = i.IsActive, Keys = keys.ContainsKey(i.Id) ? keys[i.Id] : 0 });
  }
  return lines.OrderBy(l => l.Active ? 0 : 1).ToList();
}

/// The roles the accounts `ids` hold inside an organisation they are an active member of, with the organisation.
[SuppressWarning("cost-unbounded-read")]   // the organisation roles of the integrations the list already took — 200 at most
List<MembershipRole> OrganizationRolesOf(List<Guid> ids) {
  if (ids.Count == 0) { return []; }
  return MembershipRole.Where(x => ids.Contains(x.Membership.Member.Id) && x.Membership.IsActive)
    .Include(x => x.Membership.Organization).Include(x => x.Membership.Member).ToList();
}

/// How many live keys one integration holds — a row of `IntegrationLines`' grouped count.
public class IntegrationKeyCount {
  public Guid Holder;
  public int Count;
}
