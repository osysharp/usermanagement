// The API keys page — every key in use, whose it is, what it is for, who issued it and when it was last used; issuing
// one (shown once, with a copy button) and revoking one. Set in Osysharp.Ui's settings vocabulary like the people list.
//
// ⚑ NOTHING HERE READS A KEY BACK. A key is shown once, in the moment it is issued, to the manager who issued it; after
//   that its last four characters are what tell two apart.

namespace Osysharp.UserManagement;

using Osysharp.Identity;
using Osysharp.Ui;

/// The keys, issuing one and revoking one, and the integrations that hold them. In a test: `Ui.Click("Issue a key")`,
/// `Ui.Select("For", ada)`, `Ui.Fill("What it is for", "Nightly export")`, `Ui.Click("Issue it")` — or
/// `Ui.Click("Add an integration")`, `Ui.Fill("Name", "Zapier")`, `Ui.Click("Agent")`, `Ui.Click("Add it and issue a key")`
/// — or, for one whose owner has left, `Ui.Click("Reassign", within: "Integrations")`, `Ui.Select("New owner", sam)`,
/// `Ui.Click("Reassign it")`.
[Composable]
public component ApiKeyManager() {
  List<ApiKeyLine> lines = [];
  List<ApiKeyLine> revoked = [];
  List<Principal> holders = [];
  bool showRevoked = false;
  string notice = "";
  // issuing
  bool issuing = false;
  Principal? forWhom = null;
  string name = "";
  string problem = "";
  // a key, shown once
  string key = "";
  string keyFor = "";
  bool copied = false;
  // integrations
  List<IntegrationLine> integrations = [];
  List<RoleOption> roles = [];
  bool adding = false;
  string integrationName = "";
  RoleOption? integrationRole = null;
  // Added holding no role, for an app that gives an integration its role by a route of its own.
  bool integrationNoRole = false;
  string addProblem = "";
  Guid switchingOff = Guid.Empty;
  string switchingOffName = "";
  // reassigning an integration to a new owner
  Guid reassigning = Guid.Empty;
  string reassigningName = "";
  string reassigningFrom = "";
  List<Principal> owners = [];
  Principal? newOwner = null;
  string reassignReason = "";
  string reassignProblem = "";
  // revoking
  Guid revoking = Guid.Empty;
  string revokingName = "";
  string revokingWhose = "";
  string revokingWords = "";

  // Where the page's one read stands: not yet answered, or why it failed.
  bool loaded = false;
  string loadProblem = "";
  string[] keyColumns = ["Name", "Ending", "Acts as", "Issued by", "Issued", "Last used", ""];
  string keyCols = "minmax(0, 1.5fr) 64px minmax(0, 1.2fr) minmax(0, 1.1fr) 92px 84px 76px";
  string[] revokedColumns = ["Name", "Ending", "Acted as", "Issued by", "Issued", "Revoked"];
  string revokedCols = "minmax(0, 1.5fr) 64px minmax(0, 1.2fr) minmax(0, 1.1fr) 92px minmax(0, 1.4fr)";
  string[] integrationColumns = ["Name", "Role", "Owner", "Keys", ""];
  string integrationCols = "minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1.3fr) 88px 196px";

  on mount { Load(); }

  action Load() {
    loadProblem = "";
    try {
      var now = DateTime.UtcNow;
      lines = ApiKeyLines(now);
      revoked = ApiKeyLines(now, withRevoked: true).Where(l => l.Revoked).ToList();
      integrations = IntegrationLines();
    } catch (Exception ex) { loadProblem = ex.Message; }
    loaded = true;
  }
  action StartAdd() {
    roles = OfferedRoles(RoleScope.App).Where(o => o.Role != null).ToList();
    integrationName = ""; integrationRole = null; integrationNoRole = false; addProblem = ""; adding = true;
  }
  action StopAdd() { adding = false; }
  action ChooseRole(RoleOption o) { integrationRole = o; integrationNoRole = false; }
  action ChooseNoRole() { integrationRole = null; integrationNoRole = true; }
  // ONE STEP: the integration is added and its first key issued, shown once — an integration with no key does nothing.
  action AddAndIssue() {
    addProblem = "";
    try {
      if (integrationRole == null && !integrationNoRole) { addProblem = "Choose what it may do — the role it acts with, or no role yet."; return; }
      var made = integrationNoRole ? AddIntegration(integrationName) : AddIntegration(integrationName, integrationRole!.Role!.Value);
      var issued = IssueApiKey(made, integrationName);
      key = issued.Key;
      keyFor = made.DisplayName + " — " + integrationName.Trim();
      notice = "";
      adding = false;
      Load();
    } catch (Exception ex) { addProblem = ex.Message; }
  }
  action AskSwitchOff(IntegrationLine line) { switchingOff = line.Id; switchingOffName = line.Name; }
  action StopSwitchOff() { switchingOff = Guid.Empty; }
  // Whoever answers for it can be anyone active on the people list — a person, never another integration.
  action AskReassign(IntegrationLine line) {
    owners = KeyHolders().Where(p => !(p is Integration)).ToList();
    reassigning = line.Id; reassigningName = line.Name; reassigningFrom = line.Owner;
    newOwner = null; reassignReason = ""; reassignProblem = "";
  }
  action StopReassign() { reassigning = Guid.Empty; }
  action Reassign() {
    reassignProblem = "";
    try {
      if (newOwner == null) { reassignProblem = "Choose who answers for it from now on."; return; }
      ReassignIntegration(Integration.Single(i => i.Id == reassigning), newOwner!, reassignReason);
      notice = reassigningName + " is now answered for by " + HolderName(newOwner!) + ". Its keys go on working.";
      reassigning = Guid.Empty;
      Load();
    } catch (Exception ex) { reassignProblem = ex.Message; }
  }
  action SwitchOff() {
    try {
      Deactivate(Integration.Single(i => i.Id == switchingOff));
      notice = switchingOffName + " is switched off — every key it held is refused from now on.";
      switchingOff = Guid.Empty;
      Load();
    } catch (Exception ex) { notice = ex.Message; switchingOff = Guid.Empty; }
  }
  action StartIssue() {
    holders = KeyHolders();
    forWhom = null;
    name = ""; problem = ""; issuing = true;
  }
  action StopIssue() { issuing = false; }
  action Issue() {
    problem = "";
    try {
      if (forWhom == null) { problem = "Choose who the key is for."; return; }
      var made = IssueApiKey(forWhom!, name);
      key = made.Key;
      keyFor = HolderName(forWhom!) + " — " + name.Trim();
      notice = "";
      issuing = false;
      Load();
    } catch (Exception ex) { problem = ex.Message; }
  }
  action DoneWithKey() { key = ""; keyFor = ""; copied = false; }
  action CopyKey() { Clipboard.Copy(key); copied = true; }
  action AskRevoke(ApiKeyLine line) {
    revoking = line.Id;
    revokingName = "“" + line.Name + "”";
    revokingWhose = line.Ending + " of " + line.Holder;
    revokingWords = "“" + line.Name + "” " + line.Ending + " of " + line.Holder;
  }
  action StopRevoke() { revoking = Guid.Empty; }
  action Revoke() {
    try {
      RevokeApiKey(ApiKey.Single(k => k.Id == revoking));
      notice = "Revoked " + revokingWords + " — a request that presents it is refused from now on.";
      revoking = Guid.Empty;
      Load();
    } catch (Exception ex) { notice = ex.Message; revoking = Guid.Empty; }
  }
  action ToggleRevoked() { showRevoked = !showRevoked; }

  string HolderName(Principal p) {
    if (p is Integration) { return p.DisplayName + " (integration)"; }
    return p.DisplayName != "" ? p.DisplayName : p.Email;
  }
  /// What the Role column says of an integration: its roles by name; that it holds one the app does not list among
  /// those it offers; or that it holds none.
  string RoleWords(IntegrationLine i) {
    if (i.Roles != "") { return i.Roles; }
    return i.HoldsRole ? "A role this app does not list" : "Holds no role";
  }
  /// Whether a key acts as an integration that holds no role — accepted, and admitted by nothing that needs one.
  bool ActsWithNoRole(ApiKeyLine line) { return integrations.Any(i => i.Id == line.HolderId && !i.HoldsRole); }

  render {
    SettingsPage("API keys", description: "A key lets a program call this app's API — as an integration of its own, or as the person it was issued to — with exactly what its holder may do. It is shown once, when it is issued.") {
      if (notice != "") { Alert(notice); }
      if (key != "") {
        Card(title: "The key for " + keyFor) {
          Stack(gap: 2, label: "API key") {
            Text("Copy it into the program now — it is not shown again. The program sends it in the X-API-Key header.",
                 fontSize: FontSize.Label, color: Colors.TextSecondary);
            Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap) {
              Box(px: 3, py: 2, rounded: Radius.Md, bg: Colors.Sunken, borderW: 1, border: Colors.Border, maxW: "100%", grow: 1, minW: "0") {
                Text(key, fontFamily: Font.Mono, fontSize: FontSize.Label, wordBreak: WordBreak.BreakAll, userSelect: UserSelect.All);
              }
              Button(copied ? "Copied" : "Copy", onPress: CopyKey, tone: Tone.Default, size: Size.Sm, announceAs: "Copy the key");
            }
            Row { Button("I have copied it", onPress: DoneWithKey, tone: Tone.Primary, size: Size.Sm); }
          }
        }
      }
      // Each list: its heading, what it is under it, its one action beside it — then the records, the page's full width.
      Stack(gap: 3, role: UiRole.Region, label: "Keys") {
        TableHeading("Keys in use", description: "Each acts as its holder and nobody else. Revoke one and the next request that presents it is refused; deactivating a person revokes theirs.") {
          Button("Issue a key", onPress: StartIssue, tone: Tone.Primary, size: Size.Sm);
        }
        RecordTable("Keys in use", keyColumns, keyCols, loaded: loaded, empty: lines.Count == 0, problem: loadProblem, onRetry: Load) {
          if (lines.Count == 0) {
            Box(p: 5) {
              EmptyState(revoked.Count > 0 ? "No keys in use" : "No keys yet", body: "Issue one to let a program call this app's API as somebody on the team.");
            }
          }
          foreach (var line in lines) {
            RecordRow(keyColumns, [line.Name, line.Ending, line.Holder, line.IssuedBy, line.IssuedOn, line.Used], keyCols,
                      note: ActsWithNoRole(line) ? line.Holder + " holds no role — this key is accepted and can do nothing that needs one." : "") {
              Button("Revoke", onPress: () => AskRevoke(line), size: Size.Sm, announceAs: "Revoke " + line.Name);
            }
          }
        }
      }
      Stack(gap: 3, role: UiRole.Region, label: "Programs") {
        TableHeading("Integrations", description: "A program that works with the app under its own name — what it does is recorded as its own, never as a teammate's. It holds keys and a role, and can never sign in. Switch it off and every key it holds stops working.") {
          Button("Add an integration", onPress: StartAdd, size: Size.Sm);
        }
        RecordTable("Integrations", integrationColumns, integrationCols, loaded: loaded, empty: integrations.Count == 0, problem: loadProblem, onRetry: Load) {
          if (integrations.Count == 0) {
            Box(p: 5) {
              EmptyState("No integrations yet", body: "Add one for each program that calls the app — Zapier, a nightly export, a partner's system.");
            }
          }
          foreach (var i in integrations) {
            // It keeps working when its owner leaves; the mark is what tells a manager to give it to somebody who is here.
            RecordRow(integrationColumns, [i.Name, RoleWords(i), i.Owner, i.Keys.ToString()], integrationCols,
                      mark: i.OwnerActive ? "" : "Owner deactivated", markTone: Tone.Warning,
                      note: i.HoldsRole ? "" : "It can do nothing that needs a role until it is given one.") {
              Button("Reassign", onPress: () => AskReassign(i), size: Size.Sm, announceAs: "Reassign " + i.Name);
              Button("Switch off", onPress: () => AskSwitchOff(i), size: Size.Sm, announceAs: "Switch off " + i.Name);
            }
          }
        }
      }
      if (revoked.Count > 0) {
        Stack(gap: 3, role: UiRole.Region, label: "Revoked") {
          TableHeading("Revoked", description: "Kept so you can see what a key was for and who took it away.") {
            Button(showRevoked ? "Hide revoked keys" : $"Show revoked keys ({revoked.Count})", onPress: ToggleRevoked, size: Size.Sm);
          }
          if (showRevoked) {
            RecordTable("Revoked keys", revokedColumns, revokedCols) {
              foreach (var line in revoked) {
                RecordRow(revokedColumns, [line.Name, line.Ending, line.Holder, line.IssuedBy, line.IssuedOn, line.RevokedWords], revokedCols,
                          actions: false, faded: true);
              }
            }
          }
        }
      }
    }
    if (issuing) {
      Dialog("Issue an API key", onDismiss: StopIssue,
             subtitle: "The program that holds it acts as this person — it can do exactly what they can, and nothing more.") {
        if (holders.Count == 0) {
          Hint("There is nobody to issue a key to — every account on the people list is deactivated.");
        } else {
          Dropdown("For", value: forWhom, options: holders, placeholder: "Choose a person…") { p => Text(HolderName(p)); }
        }
        Field("What it is for", value: name, placeholder: "Nightly export", hint: "How you will recognise it in the list.");
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Row(gap: 2, justify: Justify.End) {
          Button("Cancel", onPress: StopIssue, tone: Tone.Ghost);
          Button("Issue it", onPress: Issue, tone: Tone.Primary, disabled: holders.Count == 0);
        }
      }
    }
    if (adding) {
      Dialog("Add an integration", onDismiss: StopAdd,
             subtitle: "It acts under its own name with the role you choose, and you answer for it. It gets its first key now.") {
        Field("Name", value: integrationName, placeholder: "Zapier", hint: "What it is — everything it does is recorded under this name.");
        Stack(gap: 1, label: "What it may do") {
          Text("What it may do", fontSize: FontSize.Label, fontWeight: FontWeight.Medium);
          Row(gap: 2, wrap: Wrapping.Wrap) {
            foreach (var o in roles) {
              Button(o.Label, onPress: () => ChooseRole(o), size: Size.Sm,
                     tone: integrationRole != null && integrationRole!.Label == o.Label ? Tone.Primary : Tone.Default);
            }
            Button("No role yet", onPress: ChooseNoRole, size: Size.Sm, tone: integrationNoRole ? Tone.Primary : Tone.Default);
          }
          if (integrationRole != null) {
            Text(integrationRole!.Description, fontSize: FontSize.Caption, color: Colors.TextSecondary);
          }
          if (integrationNoRole) {
            Text("It is added holding no role: its key is accepted, and it can do nothing that needs a role until it is given one.",
                 fontSize: FontSize.Caption, color: Colors.TextSecondary);
          }
        }
        if (addProblem != "") { Alert(addProblem, tone: Tone.Danger); }
        Row(gap: 2, justify: Justify.End) {
          Button("Cancel", onPress: StopAdd, tone: Tone.Ghost);
          Button("Add it and issue a key", onPress: AddAndIssue, tone: Tone.Primary);
        }
      }
    }
    if (switchingOff != Guid.Empty) {
      Dialog("Switch off " + switchingOffName + "?", onDismiss: StopSwitchOff,
             subtitle: "Every key it holds is refused from its next request. What it already did stays recorded under its name.") {
        Row(gap: 2, justify: Justify.End) {
          Button("Cancel", onPress: StopSwitchOff, tone: Tone.Ghost);
          Button("Switch it off", onPress: SwitchOff, tone: Tone.Danger);
        }
      }
    }
    if (reassigning != Guid.Empty) {
      Dialog("Reassign " + reassigningName, onDismiss: StopReassign,
             subtitle: "Choose who answers for it from now on: who to ask what it does and whether it is still needed. "
                     + "Its keys and its role stay as they are, and the change is recorded.") {
        Text("Owned by " + reassigningFrom, fontSize: FontSize.Label, color: Colors.TextSecondary);
        Dropdown("New owner", value: newOwner, options: owners, placeholder: "Choose a person…") { p => Text(HolderName(p)); }
        Field("Why", value: reassignReason, placeholder: "They left the team", hint: "Kept with the change in the access trail.");
        if (reassignProblem != "") { Alert(reassignProblem, tone: Tone.Danger); }
        Row(gap: 2, justify: Justify.End) {
          Button("Cancel", onPress: StopReassign, tone: Tone.Ghost);
          Button("Reassign it", onPress: Reassign, tone: Tone.Primary);
        }
      }
    }
    if (revoking != Guid.Empty) {
      Dialog("Revoke " + revokingName + "?", onDismiss: StopRevoke,
             subtitle: "The key " + revokingWhose + ". A program that still uses it is refused from its next request. This cannot be undone — issue a new key instead.") {
        Row(gap: 2, justify: Justify.End) {
          Button("Cancel", onPress: StopRevoke, tone: Tone.Ghost);
          Button("Revoke it", onPress: Revoke, tone: Tone.Danger);
        }
      }
    }
  }
}
