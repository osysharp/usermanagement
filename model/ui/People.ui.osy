// The user manager's screens — the people list with one person open beside it, and the app-wide trail of changes.
// Set in Osysharp.Ui's settings vocabulary (`SettingsPage`, `SettingsSection`), so they sit in an app's settings area
// like every other admin page. Every colour, face and size is a theme token.
//
// ⚑ NO POLICY IS NAMED IN HERE (the kit cannot read the app's `ManagesPeople` in its own code): the app gates the PAGE
//   these sit on. Whether to offer an invitation is the app's `MayInvite`, ASKED OF THE SERVER (`MayInvitePeople()`) —
//   never reflected onto a control, which could read only the caller's own rows — so the app's answer may read any
//   table. A control offered to somebody who may not use it is refused by the kit's rules, with the reason.

namespace Osysharp.UserManagement;

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Invitations;
using Osysharp.Ui;

/// The user manager: search, the people, one person in full beside the list (a screen of its own on a phone), and the
/// invitations still waiting. Whether to offer an invitation is the app's `MayInvite`, which the manager asks the server
/// once (`MayInvitePeople()`) — so the app's policy may read a table. `canInvite: false` leaves inviting out whatever the
/// policy says (a page that brings people in another way); it never widens it. `invitations: false` leaves the waiting invitations out, for a page that shows them on their own (`InvitationList`).
/// In a test: `Ui.Fill("Search people", "ada"); Ui.Click("Ada Lindqvist"); Ui.Click("Sign out everywhere")`.
[Composable]
public component PeopleManager(bool canInvite = true, bool invitations = true) {
  string search = "";
  bool showInactive = true;
  List<PersonRow> people = [];
  Guid open = Guid.Empty;
  PersonDetail detail = new PersonDetail();
  bool inviting = false;
  // Whether the list has been read yet. Until it has, the list holds rows' places rather than saying "Nobody matches":
  // a page paints before its reads answer, and an empty list is a claim about the people, not about the wait.
  bool loaded = false;
  // The server's answer to the app's `MayInvite`, for the caller — false until it is asked, so nothing is offered early.
  bool mayInvite = false;
  live var invites = canInvite && mayInvite;

  on mount { if (canInvite) { mayInvite = MayInvitePeople(); } people = PeopleList(); loaded = true; }

  action Find() { people = PeopleList(search, showInactive); }
  action Open(Guid id) { detail = PersonDetailOf(id); open = id; }
  action Close() { open = Guid.Empty; }
  action Changed() { people = PeopleList(search, showInactive); if (open != Guid.Empty) { detail = PersonDetailOf(open); } }
  action StartInvite() { inviting = true; }
  action StopInvite() { inviting = false; }
  action Invited() { inviting = false; }

  render {
    Row(gap: 0, align: Align.Stretch, w: "100%", minH: "100%") {
      if (open == Guid.Empty || Layout.AtLeast(Laptop)) {
        Stack(gap: 4, grow: 1, minW: "0", maxW: "1120px", px: Space.SettingsPageX, py: 5) {
          PageHead("People", subtitle: "Who works here, what each may do, and who changed it.") {
            if (invites) { Button("Invite someone", onPress: StartInvite, tone: Tone.Primary, shortcut: "I"); }
          }
          // ── the list: a dense table on its own surface, its toolbar above it ──────────────────────────────────
          // ⚑ THE SWITCHBOARD FLOOR'S DENSE LIST (the helpdesk queue's): a compact filter rather than a page-wide
          //   field, a header row in caption type, 44px rows with an avatar, roles as chips, and the last sign-in in
          //   words ("2 h ago", "Never") — so the list reads as a list, never as an unfinished form.
          Stack(gap: 0, bg: Colors.Surface, borderW: 1, border: Colors.Border, rounded: Radius.Lg, overflow: Overflow.Hidden) {
            Row(gap: 3, align: Align.Center, wrap: Wrapping.Wrap, px: 3, py: 2, borderBW: 1, border: Colors.Border) {
              // The field IS the box (so its focus ring is the box's), with the glass laid over its left edge.
              Box(position: Position.Relative, w: Layout.AtLeast(Tablet) ? "280px" : "100%") {
                Input(value: search, label: "Search people", placeholder: "Find by name or address", onEnter: Find,
                      w: "100%", h: Length.ControlSm, pl: 7, pr: 2, rounded: Radius.Md, borderW: 1, border: Colors.Border,
                      bg: Colors.Bg, fontSize: FontSize.Label);
                Box(position: Position.Absolute, left: "10px", top: "0", bottom: "0", display: Display.Flex,
                    align: Align.Center, decorative: true) {
                  Icon(Icons.Search, size: 14, color: Colors.TextMuted);
                }
              }
              Checkbox("Show deactivated people", value: showInactive, onToggle: Find);
              Spacer();
              Text(!loaded ? "" : people.Count == 1 ? "1 person" : people.Count + " people", fontFamily: Font.Mono,
                   fontSize: FontSize.Caption, color: Colors.TextMuted, fontVariant: FontVariant.TabularNums);
            }
            if (Layout.AtLeast(Tablet)) {
              Row(gap: 3, align: Align.Center, px: 3, py: 2, bg: Colors.Sunken, borderBW: 1, border: Colors.Border, decorative: true) {
                Text("Person", fontSize: FontSize.Caption, fontWeight: FontWeight.Medium, color: Colors.TextMuted, grow: 1, pl: 7);
                Text("Roles", fontSize: FontSize.Caption, fontWeight: FontWeight.Medium, color: Colors.TextMuted, w: "200px");
                Text("Two-step", fontSize: FontSize.Caption, fontWeight: FontWeight.Medium, color: Colors.TextMuted, w: "88px");
                Text("Last signed in", fontSize: FontSize.Caption, fontWeight: FontWeight.Medium, color: Colors.TextMuted, w: "104px",
                     textAlign: TextAlign.Right);
              }
            }
            Stack(gap: 0, role: UiRole.List, label: "Everyone") {
              if (!loaded) {
                // A person row's height (44px), three times — the list's place while it is read.
                Box(px: 3, py: 3) { Skeleton(); }
                Box(px: 3, py: 3) { Skeleton(); }
                Box(px: 3, py: 3) { Skeleton(shape: SkeletonShape.HalfLine); }
              } else if (people.Count == 0) {
                Box(p: 5) {
                  EmptyState("Nobody matches", body: search == "" ? "There is nobody here yet — invite someone." : $"Nobody's name or address contains “{search}”.");
                }
              }
              foreach (var p in people) { PersonListRow(p, p.Id == open, () => Open(p.Id), Layout.AtLeast(Tablet)); }
            }
          }
          if (invitations) {
            Stack(gap: 2, pt: 2) {
              Text("Waiting invitations", fontWeight: FontWeight.Semibold);
              InvitationList(canChange: invites);
            }
          }
        }
      }
      if (open != Guid.Empty) {
        Stack(gap: 0, w: Layout.AtLeast(Laptop) ? Length.DrawerW : "100%", shrink: 0, borderLW: 1, border: Colors.DrawerLine,
              bg: Colors.Surface, minH: "100%") {
          PersonPanel(detail, Changed, Close);
        }
      }
    }
    if (inviting) {
      Dialog("Invite someone", onDismiss: StopInvite, subtitle: "They get a link by mail, and join with the role you choose.") {
        InviteForm(onSent: Invited, canSend: invites);
      }
    }
  }
}

/// One person in the list — a lamp for whether they may sign in, their name and address, their roles, whether
/// two-step sign-in is on, and when they last signed in.
[Composable, Part]
public component PersonListRow(PersonRow p, bool current, Action onOpen, bool columns = true) {
  variants {
    base { Display = Display.Flex; Px = 3; Py = 2; Gap = 3; BorderBW = 1; Border = Colors.Border; Cursor = Cursor.Pointer;
           Bg = Colors.Surface; Transition = Motion.Fast; Hover { Bg = Colors.Muted; } }
    current { Bg = Colors.Primary.Subtle; Hover { Bg = Colors.Primary.Subtle; } }
  }
  render {
    Pressable(onClick: onOpen, label: p.Name, role: UiRole.ListItem, current: current) {
      Row(gap: 3, align: Align.Center, w: "100%", minW: "0") {
        // The avatar carries whether they can sign in: a deactivated account is drawn faded, with its word beside the name.
        Box(position: Position.Relative, shrink: 0, opacity: p.Active ? "1" : "0.45") {
          Avatar(PersonInitials(p.Name), size: Size.Sm);
        }
        Stack(gap: 0, grow: 1, minW: "0") {
          Row(gap: 2, align: Align.Center, minW: "0") {
            Text(p.Name, fontSize: FontSize.Label, fontWeight: FontWeight.Medium,
                 color: p.Active ? Colors.OnSurface : Colors.TextMuted, whiteSpace: WhiteSpace.Nowrap,
                 overflow: Overflow.Hidden, textOverflow: TextOverflow.Ellipsis, minW: "0");
            if (!p.Active) { Badge("Deactivated", tone: Tone.Ghost); }
          }
          Text(p.Email + (p.Organizations != "" ? " · " + p.Organizations : ""), fontSize: FontSize.Caption, color: Colors.TextMuted,
               whiteSpace: WhiteSpace.Nowrap, overflow: Overflow.Hidden, textOverflow: TextOverflow.Ellipsis, minW: "0");
          // On a phone the columns fold under the name: the roles, and whether two-step is on.
          if (!columns && (p.Roles != "" || p.SecondFactorOn)) {
            Row(gap: 1, wrap: Wrapping.Wrap, pt: 1) {
              foreach (var r in RolesOf(p)) { Badge(r, tone: RoleTone(r)); }
              if (p.SecondFactorOn) { Badge("Two-step on", tone: Tone.Ghost); }
            }
          }
        }
        if (columns) {
          Row(gap: 1, wrap: Wrapping.Wrap, w: "200px", shrink: 0) {
            foreach (var r in RolesOf(p)) { Badge(r, tone: RoleTone(r)); }
            if (p.Roles == "") { Text("No role", fontSize: FontSize.Caption, color: Colors.TextMuted); }
          }
          Row(gap: 1, align: Align.Center, w: "88px", shrink: 0) {
            Lamp(lit: p.SecondFactorOn, tone: Tone.Success);
            Text(p.SecondFactorOn ? "On" : "Off", fontSize: FontSize.Caption, color: p.SecondFactorOn ? Colors.OnSurface : Colors.TextMuted);
          }
        }
        Text(SignedInWhen(p.LastSignIn, DateTime.UtcNow), fontSize: FontSize.Caption,
             color: p.LastSignIn == null ? Colors.TextMuted : Colors.TextSecondary, w: columns ? "104px" : "auto", shrink: 0,
             textAlign: TextAlign.Right, fontVariant: FontVariant.TabularNums, whiteSpace: WhiteSpace.Nowrap);
      }
    }
  }
}

/// A person's roles, one per chip.
public List<string> RolesOf(PersonRow p) {
  List<string> roles = [];
  if (p.Roles == "") { return roles; }
  foreach (var r in p.Roles.Split(", ")) { roles.Add(r); }
  return roles;
}

/// The chip colour for a role: the accent for the role that runs the app, quiet for the rest. Read off the WORD the app
/// gives its roles, so an app whose top role is "Owner" reads the same.
public Tone RoleTone(string role) => role == "Admin" || role == "Owner" ? Tone.Primary : Tone.Default;

/// Two letters for an avatar — the first of the first and last names.
public string PersonInitials(string name) {
  var parts = name.Trim().Split(" ");
  if (parts.Length == 0 || parts[0] == "") { return "?"; }
  var first = parts[0].Substring(0, 1).ToUpper();
  return parts.Length > 1 && parts[parts.Length - 1] != "" ? first + parts[parts.Length - 1].Substring(0, 1).ToUpper() : first;
}

/// When somebody last signed in, in words: "Today, 09:12", "Yesterday", "3 days ago", "12 Mar" — and "Never".
public string SignedInWhen(DateTime? at, DateTime now) {
  if (at == null) { return "Never"; }
  var days = (now.Date - at.Value.Date).TotalDays;
  if (days < 1.0) { return "Today, " + at.Value.ToString("HH:mm"); }
  if (days < 2.0) { return "Yesterday"; }
  if (days < 7.0) { return Convert.ToInt(Math.Floor(days)) + " days ago"; }
  return at.Value.ToString("d MMM");
}

/// One person in full, for a people manager — and every change to their access, each with its reason.
[Composable]
public component PersonPanel(PersonDetail d, Action onChanged, Action onClose) {
  string problem = "";
  string done = "";
  RoleOffer? giving = null;
  // The role being taken away, by the name the app gives it — "" while none is.
  string removing = "";
  // Whether "Add role" is open: every role the app offers, the held ones marked.
  bool adding = false;
  string reason = "";
  string asking = "";

  action Reload() { onChanged(); }
  action Ask(string what) { asking = what; reason = ""; problem = ""; }
  action AskRemove(string role) { removing = role; Ask("revoke"); }
  action StopAsking() { asking = ""; removing = ""; }
  action ToggleAdding() { adding = !adding; }
  action Run(string what) {
    problem = "";
    done = "";
    try {
      var p = Principal.Single(x => x.Id == d.Id);
      if (what == "grant" && giving != null && giving.Role != null) { GrantRole(p, giving.Role.Value, reason); done = $"{d.Name} is now {giving.Label}."; giving = null; }
      if (what == "revoke") {
        foreach (var held in d.Roles) {
          if (held.Organization == "" && held.Removable && held.Label == removing && held.Role != null) {
            RevokeRole(p, held.Role.Value, reason);
            done = $"{held.Label} was taken from {d.Name}.";
          }
        }
        removing = "";
      }
      if (what == "deactivate") { Deactivate(p, reason); done = $"{d.Name} can no longer sign in, and was signed out everywhere."; }
      if (what == "reactivate") { Reactivate(p, reason); done = $"{d.Name} can sign in again."; }
      if (what == "reset") { ResetSecondFactor(p, reason); done = $"Two-step sign-in was reset for {d.Name}; they set it up again when they next sign in."; }
      if (what == "signout") { SignOutEverywhere(p, reason); done = $"{d.Name} was signed out everywhere."; }
      asking = "";
      reason = "";
      Reload();
    }
    catch (Exception ex) { problem = ex.Message; }
  }
  action Give(RoleOffer c) { giving = c; Run("grant"); }

  /// The app roles of theirs a manager may take away — the ones the danger area lists.
  List<HeldRole> Removable() { return d.Roles.Where(r => r.Organization == "" && r.Removable).ToList(); }
  /// What deactivating does, in one line — for a person, and for a program, which has keys and no sessions.
  string DeactivateWords() {
    return d.IsIntegration ? "Every key it holds is refused from its next request. What it did stays recorded under its name."
                           : "They cannot sign in, and every session they have ends. Their work stays theirs.";
  }

  render {
    Stack(gap: Space.DrawerGap, px: Space.DrawerX, py: Space.DrawerY, label: d.Name) {
      Row(gap: 3, align: Align.Start) {
        Avatar(PersonInitials(d.Name), size: Size.Md);
        Stack(gap: 1, grow: 1, minW: "0") {
          Text(d.Name, fontFamily: Font.DrawerFace, fontSize: FontSize.DrawerTitle, fontWeight: FontWeight.Semibold,
               wordBreak: WordBreak.BreakWord);
          Text(d.Email, fontSize: FontSize.Label, color: Colors.DetailText, wordBreak: WordBreak.BreakAll);
          Row(gap: 2, wrap: Wrapping.Wrap, pt: 1) {
            Badge(d.Active ? "Active" : "Deactivated", tone: d.Active ? Tone.Success : Tone.Ghost);
            // An integration's address reaches nobody, so there is nothing to prove.
            if (d.IsIntegration) { Badge("Integration", tone: Tone.Ghost); }
            else { Badge(d.Verified ? "Address proven" : "Address not proven", tone: d.Verified ? Tone.Ghost : Tone.Warning); }
            if (d.SecondFactorOn) { Badge("Two-step on", tone: Tone.Ghost); }
            else if (d.SecondFactorRequired) { Badge("Two-step required, not set up", tone: Tone.Warning); }
          }
        }
        IconButton(label: "Close", onPress: onClose, tone: Tone.Ghost, shortcut: "Escape") { Icon(Icons.Close); }
      }
      if (done != "") { Alert(done, tone: Tone.Success); }
      if (problem != "") { Alert(problem, tone: Tone.Danger); }

      Stack(gap: 2, label: "Roles") {
        Row(gap: 2, align: Align.Center) {
          Text("Roles", fontWeight: FontWeight.Semibold, grow: 1);
          if (d.Offered.Count > 0) {
            Button(adding ? "Done" : "Add role", onPress: ToggleAdding, size: Size.Sm,
                   announceAs: adding ? "Done adding roles" : "Add role");
          }
        }
        if (d.Roles.Count == 0) {
          Text(d.IsIntegration ? "Holds no role — its keys are accepted, and it can do nothing that needs one."
                               : "No roles — they can sign in, and do nothing that needs one.",
               color: Colors.TextMuted, fontSize: FontSize.Caption);
        }
        if (d.Roles.Count > 0) {
          Row(gap: 1, wrap: Wrapping.Wrap, label: "Roles held") {
            foreach (var r in d.Roles) { Badge(r.Organization != "" ? r.Label + " at " + r.Organization : r.Label, tone: RoleTone(r.Label)); }
          }
        }
        // EVERY role the app offers, so what can be given is in view at once: the held ones say so, the rest are added
        // here. Whether the app's own rules let THIS manager give one is the server's to say — it refuses with the reason.
        if (adding) {
          Stack(gap: 0, borderW: 1, border: Colors.ControlBorder, rounded: Radius.Md, overflow: Overflow.Hidden,
                role: UiRole.List, label: "Add role") {
            foreach (var o in d.Offered) { RoleOfferRow(o, () => Give(o), () => AskRemove(o.Label)); }
          }
        }
      }

      Stack(gap: 2, label: "Signing in") {
        Text("Signing in", fontWeight: FontWeight.Semibold);
        Text(d.IsIntegration ? "An integration never signs in — it acts through its API keys."
             : d.LastSignIn == null ? "Has never signed in." : "Last signed in " + d.LastSignIn.Value.ToString("d MMM yyyy, HH:mm") + ".",
             fontSize: FontSize.Caption, color: Colors.TextMuted);
        if (!d.IsIntegration) {
          Text(d.SignedIn == 0 ? "Not signed in anywhere right now." : d.SignedIn == 1 ? "Signed in on 1 browser or device right now." : $"Signed in on {d.SignedIn} browsers or devices right now.",
               fontSize: FontSize.Caption, color: Colors.TextMuted);
        }
        if (d.SignedIn > 0 || (d.SignsInWithPassword && d.SecondFactorOn) || !d.Active) {
          Row(gap: 2, wrap: Wrapping.Wrap) {
            if (d.SignedIn > 0) { Button("Sign out everywhere", onPress: () => Ask("signout"), size: Size.Sm); }
            if (d.SignsInWithPassword && d.SecondFactorOn) { Button("Reset two-step sign-in", onPress: () => Ask("reset"), size: Size.Sm); }
            if (!d.Active) { Button("Reactivate", onPress: () => Ask("reactivate"), size: Size.Sm); }
          }
        }
      }

      Stack(gap: 2, label: "History") {
        Text("History", fontWeight: FontWeight.Semibold);
        if (d.History.Count == 0) { Text("No changes to their access yet.", color: Colors.TextMuted, fontSize: FontSize.Caption); }
        foreach (var e in d.History) {
          Stack(gap: 0, py: 1, borderBW: 1, border: Colors.RowLine) {
            Row(gap: 2, align: Align.Center) {
              Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap, grow: 1, minW: "0") {
                Text(e.What, fontSize: FontSize.Label, fontWeight: FontWeight.Medium, wordBreak: WordBreak.BreakWord);
                if (e.Refused) { Badge("Refused", tone: Tone.Danger); }
              }
              Text(e.At.ToString("d MMM HH:mm"), fontFamily: Font.Mono, fontSize: FontSize.Caption, color: Colors.TextMuted, shrink: 0);
            }
            Text("by " + e.By + (e.Reason != "" ? " — “" + e.Reason + "”" : ""), fontSize: FontSize.Caption, color: Colors.TextMuted,
                 wordBreak: WordBreak.BreakWord);
            if (e.Refused && e.Refusal != "") { Text(e.Refusal, fontSize: FontSize.Caption, color: Colors.DangerInk, wordBreak: WordBreak.BreakWord); }
          }
        }
      }

      // What takes something away from them, in ONE place and one weight: each says what follows, and each asks first.
      if (d.Active || Removable().Count > 0) {
        DangerArea() {
          foreach (var r in Removable()) {
            DangerAction("Remove " + r.Label, "They lose what " + r.Label + " lets them do, at once.", () => AskRemove(r.Label));
          }
          if (d.Active) {
            DangerAction("Deactivate", DeactivateWords(), () => Ask("deactivate"), announceAs: "Deactivate " + d.Name);
          }
        }
      }
    }
    if (asking != "") {
      Dialog(asking == "reset" ? "Reset two-step sign-in?" : asking == "deactivate" ? "Deactivate " + d.Name + "?"
             : asking == "revoke" ? "Remove " + removing + " from " + d.Name + "?"
             : asking == "reactivate" ? "Reactivate " + d.Name + "?" : "Sign " + d.Name + " out everywhere?",
             onDismiss: StopAsking,
             subtitle: asking == "reset" ? "Their authenticator app and recovery codes stop working; they set it up again at their next sign-in. Do this only when you are sure it is them asking."
               : asking == "deactivate" ? DeactivateWords()
               : asking == "revoke" ? "They lose what " + removing + " lets them do, at once. You can give it back."
               : asking == "reactivate" ? "They can sign in again with the password they had."
               : "Every session they have ends, on every device. They can sign in again.") {
        Field(asking == "reset" ? "Why — who asked, and how you knew it was them" : "Why (recorded with the change)", value: reason,
              placeholder: asking == "reset" ? "Lost phone; confirmed on a call from her desk number" : "");
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        Row(gap: 2, justify: Justify.End) {
          Button("Cancel", onPress: StopAsking, tone: Tone.Ghost);
          Button(asking == "reset" ? "Reset" : asking == "deactivate" ? "Deactivate" : asking == "revoke" ? "Remove role"
                 : asking == "reactivate" ? "Reactivate" : "Sign out everywhere",
                 onPress: () => Run(asking), tone: asking == "deactivate" || asking == "revoke" ? Tone.Danger : Tone.Primary);
        }
      }
    }
  }
}

/// One role in "Add role": what the app calls it and what it is for — and "Held" with a way to take it away, or Add.
[Composable, Part]
component RoleOfferRow(RoleOffer offer, Action onAdd, Action onRemove) {
  variants { base { BorderBW = 1; Border = Colors.RowLine; } }
  render {
    Row(gap: 3, align: Align.Center, px: 3, py: 2, role: UiRole.ListItem, label: offer.Label) {
      Stack(gap: 0, grow: 1, minW: "0") {
        Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap) {
          Text(offer.Label, fontSize: FontSize.Label, fontWeight: FontWeight.Medium);
          if (offer.Held) { Badge("Held", tone: Tone.Success); }
        }
        if (offer.Description != "") { Text(offer.Description, fontSize: FontSize.Caption, color: Colors.MetaText, wordBreak: WordBreak.BreakWord); }
      }
      if (offer.Held) { DangerButton("Remove", onRemove, "Remove " + offer.Label); }
      else { Button("Add", onPress: onAdd, size: Size.Sm, announceAs: "Add " + offer.Label); }
    }
  }
}

/// The app-wide trail of who changed whose access, newest first — an auditor's page.
/// A table: when, what, who it concerns, by whom and why — `take` at a time, with "Show more" under it, and never more
/// than `AccessTrailMost()`. A change a rule refused is marked "Refused", with the rule's reason under it.
/// In a test it is the region "Access trail": `Assert.Visible("Granted Lead", within: "Access trail")`.
[Composable]
public component AccessTrailList(int take = 50) {
  List<AccessEvent> trail = [];
  // How many are asked for; one more is read, which is how the table knows there are more to show.
  int shown = take;
  bool more = false;
  bool loaded = false;
  string problem = "";
  string[] columns = ["When", "What", "Who it concerns", "By", "Why"];
  string cols = "124px minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.4fr)";
  // The most the page ever reads (`AccessTrailMost()`), asked with the first read.
  int most = 0;

  on mount { Load(); }

  action Load() {
    problem = "";
    try {
      most = AccessTrailMost();
      var read = AccessTrail(shown + 1);
      more = read.Count > shown && shown < most;
      trail = read.Take(shown).ToList();
    } catch (Exception ex) { problem = ex.Message; }
    loaded = true;
  }
  action ShowMore() { shown = Math.Min(shown + take, most); Load(); }

  render {
    Stack(gap: 3, w: "100%") {
      RecordTable("Access trail", columns, cols, loaded: loaded, empty: trail.Count == 0, problem: problem, onRetry: Load) {
        if (trail.Count == 0) {
          Box(p: 5) { EmptyState("No changes yet", body: "Every change to somebody's access is listed here, with who made it and why."); }
        }
        foreach (var e in trail) {
          RecordRow(columns, [e.At.ToString("d MMM yyyy HH:mm"), e.Change, e.Person, e.By, e.Reason], cols, strong: 1, actions: false,
                    mark: e.Refused ? "Refused" : "", markTone: Tone.Danger, note: e.Refused ? e.Refusal : "", noteTone: Tone.Danger);
        }
      }
      if (more) { Row { Button("Show more", onPress: ShowMore, size: Size.Sm, announceAs: "Show more access changes"); } }
      else if (loaded && most > 0 && trail.Count >= most) {
        Text($"Showing the newest {most} changes.", fontSize: FontSize.Caption, color: Colors.MetaText);
      }
    }
  }
}
