// Osysharp.UserManagement — the user manager: who is in the app, what each of them may do, and who changed that, when and why.
//
// A people list (search; roles; whether each has two-step sign-in on; when they last signed in; where else they are
// signed in), and the changes a person who looks after the app's people makes: grant and revoke the app's roles,
// deactivate and reactivate an account, reset a second factor (a lost phone), sign an account out everywhere — and the
// same within an organisation. Invitations (Osysharp.Invitations) are how somebody new is brought in.
//
// ⚑ EVERY CHANGE IS A RECORD FIRST. A manager does not write somebody's access; they make an `AccessChange` — who, to
//   whom, what, why — and its run applies it, in the same commit. So the trail of who changed whose access is not a
//   log that might be missing a path: it is the only path. Nobody edits or deletes one.
//
// ⚑ THE APP SAYS ONE THING — who looks after the people:   policy ManagesPeople => IsAdmin;
//   …and which of its roles a person can be given (`app.Roles`, Osysharp.Identity) and must never be left without
//   (`app.People = new PeopleSetup { KeepOneOf = AppRole.Admin }`).
//
// ⚑ ITS OWN KIT, NOT PART OF ACCOUNTS: it administers people however they sign in (it works over `Principal`), it
//   brings in invitations and organisations — which an app that only signs people in has no use for — and an app's
//   customers sign in with Accounts without the app needing a user manager at all.
package Osysharp.UserManagement {
  version "0.9.0";
  minPlatform "0.15.0";
  summary     "the user manager: a searchable people list (roles, two-step sign-in, last sign-in, sessions), and audited access changes — grant and revoke the app's roles, deactivate and reactivate, reset a lost second factor, sign out everywhere, and the same within an organisation; API keys issued once and revoked at once, and integrations — programs that work under their own name with keys and a role and can never sign in — each one a record of who changed whose access, when and why, made only by the app's people managers.";
  model "model/**/*.osy";
  use Osysharp.Identity@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Organizations@0;
  use Osysharp.Invitations@2;
  use Osysharp.Mail@0;
  use Osysharp.Ui;
  use Osysharp.Workflow;
  tests "tests";
}
