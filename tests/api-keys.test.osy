// API KEYS — a people manager issues a key to a teammate; it is shown once, acts as that teammate and nobody else, and
// a revoked key — or every key of a deactivated account — is refused from the next request on. Each issue and revoke is
// an access change on the trail. (The team is access.test.osy's `Team`: Sam and Ari are admins, Ada an agent, Mo nobody.)
// SECURITY-INVARIANT(api-keys-are-issued-and-revoked-by-people-managers-alone).

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.UserManagement;

string Me(string key) {
  var r = Api.Get("/api/rest/v1/team/me", apiKey: key);
  return r.StatusCode == 200 ? r.Body : "HTTP " + r.StatusCode;
}

[Test(Team)]
void a_key_acts_as_the_person_it_was_issued_to_and_a_revoked_key_is_refused_at_once() {
  var ada = Person("ada@desk.test");
  IssuedApiKey issued = new IssuedApiKey();
  runas (Sam) { issued = IssueApiKey(ada, "Nightly export"); }
  Assert.StartsWith("pk_", issued.Key);
  // The key is Ada — not Sam, who issued it.
  Assert.Contains("ada@desk.test", Me(issued.Key));
  Assert.DoesNotContain("sam@desk.test", Me(issued.Key));
  runas (Sam) {
    var k = ApiKey.Single(x => x.Id == issued.Id);
    Assert.Equal(1, k.Slot);
    Assert.Equal("…" + issued.Key.Substring(issued.Key.Length - 4), k.Ending);
    // Its use is recorded, to the minute.
    Assert.NotNull(User.Single(u => u.Email == "ada@desk.test").ApiKeyUsedAt);
    RevokeApiKey(k, "Export moved to the warehouse");
  }
  // Refused at the very next request.
  Assert.Equal("HTTP 401", Me(issued.Key));
  runas (Sam) {
    var trail = AccessChange.Where(c => c.Person == ada).OrderBy(c => c.At).ToList();
    Assert.Equal(AccessChangeKind.ApiKeyIssued, trail[0].Kind);
    Assert.Equal(AccessChangeKind.ApiKeyRevoked, trail[1].Kind);
    Assert.Equal("Export moved to the warehouse", trail[1].Reason);
    Assert.Contains("Revoked the API key “Nightly export”", AccessTrail()[0].What);
  }
}

// A KEY FOR SOME TOOL SETS (KEYSCOPE D-KEYSCOPE-7): `IssueApiKey(…, tools)` mints a key that reaches only those sets — on the REST
// API the function of its catalog (`/me`), never an entity route; over MCP that catalog's tool alone — where the same person's key for
// every set reads the desk's notices too. The record says the sets. SECURITY-INVARIANT(a-scoped-key-reaches-only-its-sets).
[Test(Team)]
void a_key_issued_for_some_tool_sets_reaches_only_them() {
  var ada = Person("ada@desk.test");
  IssuedApiKey scoped = new IssuedApiKey();
  IssuedApiKey whole = new IssuedApiKey();
  runas (Sam) {
    scoped = IssueApiKey(ada, "Who-am-I bot", "", "me");
    whole = IssueApiKey(ada, "Everything");
  }
  Assert.EndsWith("~me", scoped.Key);
  Assert.Contains("ada@desk.test", Me(scoped.Key));
  Assert.Equal(404, Api.Get("/api/rest/v1/team/entities/DeskNotice", apiKey: scoped.Key).StatusCode);
  Assert.Equal(200, Api.Get("/api/rest/v1/team/entities/DeskNotice", apiKey: whole.Key).StatusCode);
  var listed = new List<string>();
  foreach (var t in Mcp.List(apiKey: scoped.Key).Tools) { listed.Add(t.Name); }
  Assert.Contains("WhoAmI", listed);
  Assert.DoesNotContain("query_DeskNotice", listed);
  var all = new List<string>();
  foreach (var t in Mcp.List(apiKey: whole.Key).Tools) { all.Add(t.Name); }
  Assert.Contains("query_DeskNotice", all);
  runas (Sam) { Assert.Equal("me", ApiKey.Single(k => k.Id == scoped.Id).Tools); }
}

[Test(Team)]
void only_a_people_manager_issues_a_key_and_nobody_reads_one_back() {
  var ada = Person("ada@desk.test");
  runas (Ada) { Assert.Denied(() => IssueApiKey(ada, "My own")); }
  IssuedApiKey issued = new IssuedApiKey();
  runas (Sam) { issued = IssueApiKey(ada, "Zapier"); }
  // Nobody reads the hash back — not the manager, not the holder.
  runas (Sam) { Assert.Null(ApiKey.Single(k => k.Id == issued.Id).PendingHash); }
  runas (Ada) {
    Assert.Equal(1, ApiKey.Count());
    Assert.Null(User.Single(u => u.Email == "ada@desk.test").ApiKeyHash);
    // …and the holder cannot take the key off, or put another on, by writing their own account.
    Assert.Denied(() => {
      var me = User.Single(u => u.Email == "ada@desk.test");
      me.ApiKeyHash = null;
      UnitOfWork.Commit();
    });
  }
  Assert.Contains("ada@desk.test", Me(issued.Key));
}

// WHAT A KEY MAY CARRY IS A MANAGER'S TO READ (KEYSCOPE D-KEYSCOPE-45): somebody who does not manage people is refused the names
// the key page offers, and an issue is refused as not theirs BEFORE anything is minted — so neither the mint's refusal (which
// names what may be chosen, or under an organization's cap says the cap) nor a key ever reaches them. A manager still reads them.
[Test(Team)]
void a_non_manager_is_refused_what_a_key_may_carry_before_any_mint() {
  var ada = Person("ada@desk.test");
  runas (Ada) {
    Assert.Denied(() => KeyToolSets());
    Assert.Denied(() => IssueApiKey(ada, "My own", "", "nope"));
  }
  runas (Sam) {
    Assert.Equal("me,notices", string.Join(",", KeyToolSets()));
    Assert.Equal(0, ApiKey.Count());
  }
}

[Test(Team)]
void two_keys_at_most_and_deactivating_a_person_revokes_theirs() {
  var ada = Person("ada@desk.test");
  IssuedApiKey first = new IssuedApiKey();
  IssuedApiKey second = new IssuedApiKey();
  runas (Sam) {
    first = IssueApiKey(ada, "Export");
    second = IssueApiKey(ada, "Zapier");
    Assert.Equal("This account already holds two keys — revoke one before issuing another.",
                 Assert.Throws<ValidationException>(() => IssueApiKey(ada, "Third")).Message);
  }
  Assert.Contains("ada@desk.test", Me(second.Key));
  runas (Sam) { Deactivate(ada, "Left the company"); }
  Assert.Equal("HTTP 401", Me(first.Key));
  Assert.Equal("HTTP 401", Me(second.Key));
  runas (Sam) {
    Assert.Equal(0, ApiKey.Count(k => k.RevokedAt == null));
    Assert.Equal("This account is deactivated — reactivate it before issuing it a key.",
                 Assert.Throws<ValidationException>(() => IssueApiKey(ada, "Again")).Message);
  }
}

// The app's own accounts — a workflow's actor, an agent's — are nobody's to change: a key issued to the access-change
// run's own account would let whoever holds it write everything that run may (give any role, put a key on anyone).
[Test(Team)]
void nobody_issues_a_key_to_or_changes_the_access_of_the_apps_own_accounts() {
  var changer = Actor.Of<AccessChanger>();
  runas (Sam) {
    Assert.Contains("the app's own account",
                    Assert.Throws<ValidationException>(() => IssueApiKey(changer, "Mine now")).Message);
    Assert.Contains("the app's own account",
                    Assert.Throws<ValidationException>(() => Deactivate(changer, "Stop it")).Message);
    Assert.Equal(0, ApiKey.Count(k => k.Holder == changer));
    Assert.Equal(0, AccessChange.Count(c => c.Person == changer));
  }
}

// A KEY SEALED FOR A HOST (PLATFORM-765): `IssueApiKeySealedFor` issues a key exactly as `IssueApiKey` does — an access change its
// run applies, a key slot on the account — but answers it only sealed (fcs1) for the host row, so nobody, the manager included, is
// shown the key. It reaches only its tool sets and ends when it was told to; a non-manager is refused before anything is minted, and
// the app's own actor issues one only once the app says it may (`IssuesApiKeys`). SECURITY-INVARIANT(a-minted-key-is-sealed-only-to-a-declared-recipient).
string HostKey() { return "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEEYiOTxMFRx6nQ0T+oUZ+Mg4ewf78+5A8Ade6U8D76HltIHBg602I3FsMsbG1/+aaXpHByOL2cQdjdOIUdSB0vQ=="; }

[Test(Team)]
void a_key_sealed_for_a_host_is_issued_as_an_access_change_and_shown_to_nobody() {
  var ada = Person("ada@desk.test");
  IssuedSealedApiKey issued = new IssuedSealedApiKey();
  runas (Sam) {
    var host = new BuildHost { Name = "ft-mini", SealingKey = HostKey() };
    UnitOfWork.Commit();
    issued = IssueApiKeySealedFor(ada, "Design review", to: host, kind: "design-read", why: "a review on ft-mini",
                                  reason: "the build host reads one design", tools: "me", expiresIn: TimeSpan.FromHours(2));
  }
  Assert.StartsWith("fcs1.", issued.Sealed);
  Assert.DoesNotContain("pk_", issued.Sealed);
  runas (Sam) {
    var k = ApiKey.Single(x => x.Id == issued.Id);
    Assert.Equal(1, k.Slot);
    Assert.Equal("me", k.Tools);
    Assert.Equal(5, k.Ending.Length);
    Assert.NotNull(k.ExpiresAt);
    Assert.True(k.ExpiresAt!.Value > DateTime.UtcNow.AddMinutes(110));
    var change = AccessChange.Single(c => c.Person == ada && c.Kind == AccessChangeKind.ApiKeyIssued);
    Assert.Equal(AccessChangeState.Applied, change.State);
    Assert.Equal("the build host reads one design", change.Reason);
  }
  // A person who does not manage people is refused before any key is minted.
  runas (Ada) {
    var host = BuildHost.Single(h => h.Name == "ft-mini");
    Assert.Denied(() => IssueApiKeySealedFor(ada, "My own", to: host, kind: "design-read", why: "mine"));
  }
  runas (Sam) { Assert.Equal(1, ApiKey.Count()); }
}

[Test(Team)]
void the_apps_own_actor_issues_a_sealed_key_once_the_app_lets_it() {
  var ada = Person("ada@desk.test");
  IssuedSealedApiKey issued = new IssuedSealedApiKey();
  runas (Actor.Of<ReviewKeys>()) {
    var host = new BuildHost { Name = "ft-mini", SealingKey = HostKey() };
    UnitOfWork.Commit();
    issued = IssueApiKeySealedForAsActor(ada, "Review session", to: host, kind: "design-read", why: "a review session",
                                         tools: "me", expiresIn: TimeSpan.FromMinutes(30));
  }
  Assert.StartsWith("fcs1.", issued.Sealed);
  runas (Sam) {
    var k = ApiKey.Single(x => x.Id == issued.Id);
    Assert.Equal(1, k.Slot);
    Assert.Equal("review-keys@desk.test", k.IssuedBy.Email);
  }
  // …and an actor the app did not name may not, nor may a manager call the actor's door.
  runas (Actor.Of<NightlyReport>()) {
    var host = BuildHost.Single(h => h.Name == "ft-mini");
    Assert.Denied(() => IssueApiKeySealedForAsActor(ada, "Not mine", to: host, kind: "design-read", why: "no"));
  }
  runas (Sam) {
    var host = BuildHost.Single(h => h.Name == "ft-mini");
    Assert.Denied(() => IssueApiKeySealedForAsActor(ada, "Not mine", to: host, kind: "design-read", why: "no"));
    Assert.Equal(1, ApiKey.Count());
  }
}

// A KEY THAT ENDS (PLATFORM-765): `IssueApiKey(…, expiresIn:)` issues a key that works until then — and the list keeps when.
[Test(Team)]
void a_key_issued_to_expire_works_until_then_and_says_when() {
  var ada = Person("ada@desk.test");
  IssuedApiKey issued = new IssuedApiKey();
  runas (Sam) { issued = IssueApiKey(ada, "One afternoon", "", "me", TimeSpan.FromHours(4)); }
  Assert.Contains("ada@desk.test", Me(issued.Key));
  runas (Sam) {
    var k = ApiKey.Single(x => x.Id == issued.Id);
    Assert.Equal("me", k.Tools);
    Assert.Equal(5, k.Ending.Length);
    Assert.NotNull(k.ExpiresAt);
  }
}
