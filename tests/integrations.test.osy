// INTEGRATIONS — a program the app is used BY, under its own name: added by a people manager with a role and a person who
// answers for it, given API keys, and never able to sign in. (The team is access.test.osy's `Team`: Sam and Ari are
// admins, Ada an agent, Mo nobody.)
// SECURITY-INVARIANT(an-integration-never-signs-in) · SECURITY-INVARIANT(api-keys-are-issued-and-revoked-by-people-managers-alone).

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Organizations;
using Osysharp.UserManagement;

string Caller(string key) {
  var r = Api.Get("/api/rest/v1/team/me", apiKey: key);
  return r.StatusCode == 200 ? r.Body : "HTTP " + r.StatusCode;
}

Integration Zapier() {
  Integration? found = null;
  runas (Sam) { found = Integration.Single(i => i.DisplayName == "Zapier"); }
  return found!;
}

principal ZapierAccount => Integration.Single(i => i.DisplayName == "Zapier");

// A manager adds an integration and issues it a key: the key acts as the integration — not as the manager — and the
// trail and the key list name it, as "Zapier", owned by the manager.
[Test(Team)]
void an_integration_holds_a_key_and_acts_under_its_own_name() {
  IssuedApiKey issued = new IssuedApiKey();
  runas (Sam) {
    var zapier = AddIntegration("Zapier", AppRole.Agent, reason: "Tickets from the web form");
    Assert.Equal("Zapier", zapier.DisplayName);
    Assert.EndsWith("@integrations.invalid", zapier.Email);
    Assert.Equal("Sam", zapier.Owner.DisplayName);
    Assert.True(RoleGrant.Any(g => g.Member == zapier && g.Role == AppRole.Agent));
    issued = IssueApiKey(zapier, "Web form");
  }
  var caller = Caller(issued.Key);
  Assert.Contains("@integrations.invalid", caller);
  Assert.DoesNotContain("sam@desk.test", caller);
  runas (Sam) {
    var line = ApiKeyLines(DateTime.UtcNow)[0];
    Assert.Equal("Zapier", line.Holder);
    // The platform still records the key's use on an account nobody may edit.
    Assert.NotNull(Integration.Single(i => i.DisplayName == "Zapier").ApiKeyUsedAt);
    Assert.Equal("Last used just now", line.LastUsed);
    var trail = AccessTrail();
    Assert.Equal("Issued the API key “Web form” " + line.Ending + " — Zapier", trail[0].What);
    Assert.Equal("Added the integration “Zapier” as Agent, owned by Sam", trail[1].What);
    Assert.Equal("Tickets from the web form", trail[1].Reason);
    var listed = IntegrationLines();
    Assert.Equal(1, listed.Count);
    Assert.Equal("Agent", listed[0].Roles);
    Assert.Equal(1, listed[0].Keys);
  }
}

// ⛔ SECURITY-INVARIANT(an-integration-never-signs-in): every sign-in door refuses it — the password, a reset, a code —
// and it has no password to try.
[Test(Team)]
void an_integration_cannot_sign_in_by_any_door() {
  string address = "";
  runas (Sam) { address = AddIntegration("Zapier", AppRole.Agent).Email; }
  Assert.Equal("", SignedIn(address, ""));
  Assert.Equal("", SignedIn(address, "correct-horse-1"));
  runas (AuthBootstrap) {
    Assert.Equal("", RequestPasswordReset(address));
    Assert.Equal(0, PasswordReset.Count());
    Assert.Throws(() => VerifyEmailCode(address, "000000"));
    Assert.Equal(0, User.Count(u => u.Email == address));
  }
}

// ⛔ Nobody edits an integration — not a manager, and not the integration itself holding its own key: a renamed one would
// put another name on everything it has done.
[Test(Team)]
void an_integration_cannot_rename_itself() {
  runas (Sam) { AddIntegration("Zapier", AppRole.Agent); }
  runas (ZapierAccount) {
    Assert.Denied(() => {
      var me = Integration.Single(i => i.DisplayName == "Zapier");
      me.DisplayName = "Ada";
      UnitOfWork.Commit();
    });
  }
  runas (Sam) {
    Assert.Denied(() => {
      var it = Integration.Single(i => i.DisplayName == "Zapier");
      it.DisplayName = "Something else";
      UnitOfWork.Commit();
    });
    Assert.Equal(1, Integration.Count(i => i.DisplayName == "Zapier"));
  }
}

// ⛔ SECURITY-INVARIANT(api-keys-are-issued-and-revoked-by-people-managers-alone): only a people manager adds an
// integration or issues it a key — the integration cannot issue itself one either — and only with a role the app offers.
[Test(Team)]
void only_a_people_manager_adds_an_integration_and_issues_its_keys() {
  runas (Ada) { Assert.Denied(() => AddIntegration("Mine", AppRole.Agent)); }
  runas (Sam) {
    Assert.Equal("That role is not one this app hands out.",
                 Assert.Throws<ValidationException>(() => AddIntegration("Mailbox", AppRole.Integration)).Message);
    AddIntegration("Zapier", AppRole.Agent);
  }
  var zapier = Zapier();
  runas (Ada) { Assert.Denied(() => IssueApiKey(zapier, "Mine")); }
  runas (ZapierAccount) { Assert.Denied(() => IssueApiKey(zapier, "Mine")); }
  runas (Sam) { Assert.Equal(0, ApiKey.Count()); }
}

// Switching an integration off revokes every key it holds, at the next request.
[Test(Team)]
void deactivating_an_integration_revokes_its_keys() {
  IssuedApiKey first = new IssuedApiKey();
  IssuedApiKey second = new IssuedApiKey();
  runas (Sam) {
    var zapier = AddIntegration("Zapier", AppRole.Agent);
    first = IssueApiKey(zapier, "Web form");
    second = IssueApiKey(zapier, "Mailbox");
  }
  Assert.Contains("@integrations.invalid", Caller(second.Key));
  runas (Sam) { Deactivate(Zapier(), "We stopped using Zapier"); }
  Assert.Equal("HTTP 401", Caller(first.Key));
  Assert.Equal("HTTP 401", Caller(second.Key));
  runas (Sam) {
    Assert.Equal(0, ApiKey.Count(k => k.RevokedAt == null));
    Assert.Equal(0, IntegrationLines().Count);
    Assert.False(IntegrationLines(withInactive: true)[0].Active);
  }
}

// A program is never the app's last admin: an integration holding the role the app must keep does not count.
[Test(Team)]
void an_integration_does_not_count_as_the_admin_the_app_must_keep() {
  runas (Sam) {
    RevokeRole(Person("ari@desk.test"), AppRole.Admin);
    AddIntegration("Robot", AppRole.Admin);
    Assert.Contains("needs at least one active",
                    Assert.Throws<ValidationException>(() => RevokeRole(Person("sam@desk.test"), AppRole.Admin)).Message);
  }
}

// An integration outlives its owner: deactivating the person who answers for it ends THEIR sessions and keys, never the
// integration's — a program a team depends on does not stop because somebody left.
[Test(Team)]
void an_integration_keeps_working_when_its_owner_is_deactivated() {
  IssuedApiKey issued = new IssuedApiKey();
  runas (Ari) {
    var zapier = AddIntegration("Zapier", AppRole.Agent);
    issued = IssueApiKey(zapier, "Web form");
  }
  runas (Sam) { Deactivate(Person("ari@desk.test"), "Left the company"); }
  Assert.Contains("@integrations.invalid", Caller(issued.Key));
  runas (Sam) {
    var line = IntegrationLines()[0];
    Assert.Equal("Ari", line.Owner);
    Assert.False(line.OwnerActive);
    Assert.Equal(1, line.Keys);
  }
}

// ⛔ SECURITY-INVARIANT(people-access-changes-are-recorded-and-the-managers-alone): an integration whose owner left is
// given to somebody who is here by a people manager, as a recorded change to access (who handed it over, to whom, why),
// and its keys go on working. Nobody else can, the integration itself included, and it is never given to a deactivated
// account, to another integration, or to the person who already answers for it.
[Test(Team)]
void a_people_manager_reassigns_an_integration_whose_owner_left_and_the_trail_records_it() {
  IssuedApiKey issued = new IssuedApiKey();
  runas (Ari) {
    var made = AddIntegration("Zapier", AppRole.Agent);
    issued = IssueApiKey(made, "Web form");
  }
  runas (Sam) { Deactivate(Person("ari@desk.test"), "Left the company"); }
  var zapier = Zapier();
  runas (Ada) { Assert.Denied(() => ReassignIntegration(zapier, Person("ada@desk.test"))); }
  runas (ZapierAccount) { Assert.Denied(() => ReassignIntegration(zapier, Person("mo@desk.test"))); }
  runas (Sam) {
    Assert.Equal("That account is deactivated — choose an active person to own the integration.",
                 Assert.Throws<ValidationException>(() => ReassignIntegration(zapier, Person("ari@desk.test"))).Message);
    Assert.Equal("An integration is answered for by a person — choose who owns it.",
                 Assert.Throws<ValidationException>(() => ReassignIntegration(zapier, zapier)).Message);
    ReassignIntegration(zapier, Person("sam@desk.test"), "Ari left — I look after the web form now");
    Assert.Equal("Sam already answers for Zapier.",
                 Assert.Throws<ValidationException>(() => ReassignIntegration(Zapier(), Person("sam@desk.test"))).Message);
    Assert.Equal("Sam", Integration.Single(i => i.DisplayName == "Zapier").Owner.DisplayName);
    var line = IntegrationLines()[0];
    Assert.Equal("Sam", line.Owner);
    Assert.True(line.OwnerActive);
    var trail = AccessTrail();
    Assert.Equal("Gave the integration “Zapier” to Sam", trail[0].What);
    Assert.Equal("Sam", trail[0].By);
    Assert.Equal("Ari left — I look after the web form now", trail[0].Reason);
  }
  Assert.Contains("@integrations.invalid", Caller(issued.Key));
}

// ── AN INTEGRATION HELD IN ONE ORGANISATION — an agent key for one customer: its role is held there (`organization:`),
//    it holds no app role, and it reads nothing of any other customer — rows, lists, counts, nor what hangs off them.
// ⛔ SECURITY-INVARIANT(an-integration-added-to-an-organisation-holds-no-app-role).

/// What `GET /entities/T` answers, as far as these tests read it.
public class EntityPage {
  public int Total;
  public bool HasMore;
}

int Total(ApiResponse r) {
  Assert.Equal(200, r.StatusCode);
  return JsonSerializer.Deserialize<EntityPage>(r.Body).Total;
}

/// Two customers of the desk, each with a ticket and a note on it, and a notice for the app's agents.
void TwoCustomers() {
  runas (Sam) {
    var acme = new Customer { Name = "Acme" };
    var beta = new Customer { Name = "Beta" };
    var a = new CustomerTicket { Customer = acme, Title = "Acme printer on fire" };
    var b = new CustomerTicket { Customer = beta, Title = "Beta invoices missing" };
    new TicketNote { Ticket = a, Text = "Acme note: toner" };
    new TicketNote { Ticket = b, Text = "Beta note: ledger" };
    new DeskNotice { Text = "Rota for December" };
    UnitOfWork.Commit();
  }
}

Customer CustomerNamed(string name) {
  Customer? found = null;
  runas (Sam) { found = Customer.Single(c => c.Name == name); }
  return found!;
}

CustomerTicket TicketOf(string customer) {
  CustomerTicket? found = null;
  runas (Sam) { found = CustomerTicket.Single(t => t.Customer.Name == customer); }
  return found!;
}

principal AcmeAgent => Integration.Single(i => i.DisplayName == "Acme feed");

/// The key of an integration added to Acme alone, holding Agent there.
string AcmeFeedKey() {
  var acme = CustomerNamed("Acme");
  string key = "";
  runas (Sam) {
    var feed = AddIntegration("Acme feed", AppRole.Agent, organization: acme, reason: "Acme's tickets arrive by API");
    key = IssueApiKey(feed, "Ticket feed").Key;
  }
  return key;
}

// Held in Acme, it does there what an Agent of Acme does — reads Acme's tickets and files one — over its own key.
[Test(Team)]
void an_integration_added_to_one_organisation_acts_with_its_role_there() {
  TwoCustomers();
  var key = AcmeFeedKey();
  var acme = CustomerNamed("Acme");
  runas (Sam) {
    var feed = Integration.Single(i => i.DisplayName == "Acme feed");
    Assert.True(HoldsIn(feed, acme, AppRole.Agent));
  }
  var read = Api.Get("/api/rest/v1/team/entities/CustomerTicket", apiKey: key);
  Assert.Equal(1, Total(read));
  Assert.Contains("Acme printer on fire", read.Body);
  var filed = Api.Post("/api/rest/v1/team/entities/CustomerTicket", new { customer = acme.Id, title = "Filed by the feed" }, apiKey: key);
  Assert.Equal(201, filed.StatusCode);
  runas (AcmeAgent) {
    new CustomerTicket { Customer = CustomerTicket.Single(t => t.Title == "Acme printer on fire").Customer, Title = "Filed as itself" };
    UnitOfWork.Commit();
  }
  runas (Sam) {
    Assert.Equal(3, CustomerTicket.Count(t => t.Customer.Name == "Acme"));
  }
}

// ⛔ The wall: a key held in Acme reads NOTHING of Beta — not its row, not its tickets nor their notes, by list, by
// count, by id or by following a reference — and files nothing there. Its positive twin is the test above.
[Test(Team)]
void an_integration_added_to_one_organisation_reads_nothing_of_another() {
  TwoCustomers();
  var key = AcmeFeedKey();
  var beta = CustomerNamed("Beta");
  var betaTicket = TicketOf("Beta");
  // Over its key: every list holds Acme's rows and none of Beta's, and its count says so.
  var customers = Api.Get("/api/rest/v1/team/entities/Customer", apiKey: key);
  Assert.Equal(1, Total(customers));
  Assert.DoesNotContain("Beta", customers.Body);
  var tickets = Api.Get("/api/rest/v1/team/entities/CustomerTicket?$expand=customer", apiKey: key);
  Assert.Equal(1, Total(tickets));
  Assert.DoesNotContain("Beta", tickets.Body);
  var notes = Api.Get("/api/rest/v1/team/entities/TicketNote?$expand=ticket", apiKey: key);
  Assert.Equal(1, Total(notes));
  Assert.Contains("Acme note: toner", notes.Body);
  Assert.DoesNotContain("Beta", notes.Body);
  // A filter that names Beta finds nothing, and Beta's rows by id are not found — which says nothing of whether they exist.
  Assert.Equal(0, Total(Api.Get("/api/rest/v1/team/entities/CustomerTicket?$filter=title eq 'Beta invoices missing'", apiKey: key)));
  Assert.Equal(404, Api.Get("/api/rest/v1/team/entities/Customer/" + beta.Id, apiKey: key).StatusCode);
  Assert.Equal(404, Api.Get("/api/rest/v1/team/entities/CustomerTicket/" + betaTicket.Id, apiKey: key).StatusCode);
  // Nor can it file a ticket under Beta.
  var filed = Api.Post("/api/rest/v1/team/entities/CustomerTicket", new { customer = beta.Id, title = "Into Beta" }, apiKey: key);
  Assert.False(filed.IsSuccess);
  // As itself, in the app: no row, count, membership or role of Beta's, and nothing reached through a reference.
  runas (AcmeAgent) {
    Assert.Equal(1, Customer.Count());
    Assert.False(Customer.Any(c => c.Name == "Beta"));
    // …nor through the kit's base type, which every organisation of every kind is a row of.
    Assert.Equal(1, Organization.Count());
    Assert.False(Organization.Any(o => o.Name == "Beta"));
    Assert.Equal(1, CustomerTicket.Count());
    Assert.Equal(0, CustomerTicket.Count(t => t.Customer.Name == "Beta"));
    Assert.Equal(1, TicketNote.Count());
    Assert.Equal(0, TicketNote.Count(n => n.Ticket.Customer.Name == "Beta"));
    Assert.False(Membership.Any(m => m.Organization.Name == "Beta"));
    Assert.Equal(0, MembershipRole.Count(r => r.Membership.Organization.Name == "Beta"));
    Assert.Denied(() => { new CustomerTicket { Customer = beta, Title = "Into Beta" }; UnitOfWork.Commit(); });
  }
  runas (Sam) { Assert.Equal(0, CustomerTicket.Count(t => t.Title == "Into Beta")); }
}

// ⛔ It holds no app role: what only an app-wide Agent reads (the desk's notices) is not its, while an integration given
// Agent across the app reads it — so the difference is where the role is held, nothing else.
[Test(Team)]
void an_integration_added_to_one_organisation_holds_no_app_role() {
  TwoCustomers();
  var acmeKey = AcmeFeedKey();
  string deskKey = "";
  runas (Sam) {
    var desk = AddIntegration("Desk robot", AppRole.Agent);
    deskKey = IssueApiKey(desk, "Robot").Key;
    var feed = Integration.Single(i => i.DisplayName == "Acme feed");
    Assert.Equal(0, RoleGrant.Count(g => g.Member == feed));
    Assert.Equal(1, Membership.Count(m => m.Member == feed));
  }
  Assert.Equal(1, Total(Api.Get("/api/rest/v1/team/entities/DeskNotice", apiKey: deskKey)));
  Assert.Equal(0, Total(Api.Get("/api/rest/v1/team/entities/DeskNotice", apiKey: acmeKey)));
  runas (AcmeAgent) { Assert.Equal(0, DeskNotice.Count()); }
}

// A role goes to an integration only where the app says it is held (`RoleChoice.HeldIn`): an app-wide one never inside
// an organisation, an organisation's never across the app — refused before anything is recorded. Only a people manager
// adds one to an organisation.
[Test(Team)]
void a_role_is_given_to_an_integration_only_where_the_app_says_it_is_held() {
  TwoCustomers();
  var acme = CustomerNamed("Acme");
  // Ada holds Agent in Acme and reads it — and still may not give Acme an integration: that is a people manager's.
  runas (Sam) { GrantInOrganization(acme, Person("ada@desk.test"), AppRole.Agent); }
  runas (Ada) { Assert.Denied(() => AddIntegration("Mine", AppRole.Agent, organization: acme)); }
  runas (Sam) {
    Assert.Equal("That role is held across the app, not inside an organisation.",
                 Assert.Throws<ValidationException>(() => AddIntegration("Acme admin", AppRole.Admin, organization: acme)).Message);
    Assert.Equal("That role is held only inside an organisation — say which organisation the integration holds it in.",
                 Assert.Throws<ValidationException>(() => AddIntegration("Team robot", AppRole.TeamLead)).Message);
    Assert.Equal(0, Integration.Count());
    Assert.Equal(0, AccessChange.Count(c => c.Kind == AccessChangeKind.IntegrationAdded));
    var lead = AddIntegration("Acme lead", AppRole.TeamLead, organization: acme);
    Assert.True(HoldsIn(lead, acme, AppRole.TeamLead));
    Assert.Equal(0, RoleGrant.Count(g => g.Member == lead));
  }
}

// The record names the organisation: the trail and the integrations list say where its role is held.
[Test(Team)]
void adding_an_integration_to_an_organisation_is_recorded_naming_it() {
  TwoCustomers();
  AcmeFeedKey();
  runas (Sam) {
    var added = AccessChange.Single(c => c.Kind == AccessChangeKind.IntegrationAdded);
    Assert.Equal("Acme", added.Organization!.Name);
    Assert.Equal("Acme feed", added.Integration!.DisplayName);
    var trail = AccessTrail();
    Assert.Equal("Added the integration “Acme feed” as Agent at Acme, owned by Sam", trail[1].What);
    Assert.Equal("Acme's tickets arrive by API", trail[1].Reason);
    Assert.Equal("Agent at Acme", IntegrationLines()[0].Roles);
  }
}

// ── added holding no role — for an app whose own rules give roles only through its own function ────────────────────

principal RelayAccount => Integration.Single(i => i.DisplayName == "Relay");

// ⛔ SECURITY-INVARIANT(an-integration-added-with-no-role-does-nothing-a-role-admits): added with no role it is given
// nothing — no grant, no membership — so its key is accepted and reads and writes exactly what a signed-in account
// holding nothing does (Mo, here): none of the rows a role or a membership admits. Given a role, it does what the role
// admits — so the difference is the role, nothing else.
[Test(Team)]
void an_integration_added_with_no_role_does_nothing_until_it_is_given_one() {
  TwoCustomers();
  var acme = CustomerNamed("Acme");
  string relayKey = "";
  string moKey = "";
  runas (Sam) {
    var relay = AddIntegration("Relay", reason: "The desk gives it its role");
    Assert.Equal("Sam", relay.Owner.DisplayName);
    Assert.Equal(0, RoleGrant.Count(g => g.Member == relay));
    Assert.Equal(0, Membership.Count(m => m.Member == relay));
    Assert.Equal(0, MembershipRole.Count(r => r.Membership.Member == relay));
    relayKey = IssueApiKey(relay, "Relay feed").Key;
    moKey = IssueApiKey(Person("mo@desk.test"), "Mo's script").Key;
  }
  // The key is accepted: the caller is the integration.
  Assert.Contains("@integrations.invalid", Caller(relayKey));
  // What a role or a membership admits is not its — list by list, the same nothing an account holding nothing reads.
  foreach (var rows in new List<string> { "Customer", "CustomerTicket", "TicketNote", "DeskNotice" }) {
    Assert.Equal(0, Total(Api.Get("/api/rest/v1/team/entities/" + rows, apiKey: moKey)));
    Assert.Equal(0, Total(Api.Get("/api/rest/v1/team/entities/" + rows, apiKey: relayKey)));
  }
  Assert.Equal(404, Api.Get("/api/rest/v1/team/entities/Customer/" + acme.Id, apiKey: relayKey).StatusCode);
  Assert.False(Api.Post("/api/rest/v1/team/entities/CustomerTicket", new { customer = acme.Id, title = "Filed by Mo" }, apiKey: moKey).IsSuccess);
  Assert.False(Api.Post("/api/rest/v1/team/entities/CustomerTicket", new { customer = acme.Id, title = "Filed by the relay" }, apiKey: relayKey).IsSuccess);
  // As itself, in the app: the same.
  runas (RelayAccount) {
    Assert.Equal(0, Customer.Count());
    Assert.Equal(0, CustomerTicket.Count());
    Assert.Equal(0, TicketNote.Count());
    Assert.Equal(0, DeskNotice.Count());
    Assert.Equal(0, RoleGrant.Count());
    // Of the trail it reads what every account reads — what was done to its own access (its key) — and no other line.
    Assert.Equal(1, AccessChange.Count());
    Assert.Equal(AccessChangeKind.ApiKeyIssued, AccessChange.Single().Kind);
    Assert.Denied(() => { new CustomerTicket { Customer = acme, Title = "Into Acme" }; UnitOfWork.Commit(); });
    Assert.Denied(() => { new DeskNotice { Text = "From the relay" }; UnitOfWork.Commit(); });
    Assert.Denied(() => AddIntegration("Its own", owner: Person("mo@desk.test")));
  }
  runas (Sam) {
    Assert.Equal(2, CustomerTicket.Count());
    Assert.Equal(1, DeskNotice.Count());
    Assert.Equal(1, Integration.Count());
    // Given a role, it reads what the role admits.
    GrantRole(Integration.Single(i => i.DisplayName == "Relay"), AppRole.Agent, "It reads the desk's notices");
  }
  Assert.Equal(1, Total(Api.Get("/api/rest/v1/team/entities/DeskNotice", apiKey: relayKey)));
  Assert.Equal(0, Total(Api.Get("/api/rest/v1/team/entities/DeskNotice", apiKey: moKey)));
}

// Its creation is on the trail, saying it holds no role; the integrations list says so until it is given one; and an
// organisation named with no role is refused before anything is recorded.
[Test(Team)]
void an_integration_added_with_no_role_is_recorded_and_listed_as_holding_none() {
  TwoCustomers();
  var acme = CustomerNamed("Acme");
  runas (Sam) {
    var relay = AddIntegration("Relay", reason: "The desk gives it its role");
    var added = AccessChange.Single(c => c.Kind == AccessChangeKind.IntegrationAdded);
    Assert.Equal(AccessChangeState.Applied, added.State);
    Assert.True(added.Role == null);
    Assert.Equal("Relay", added.Integration!.DisplayName);
    var trail = AccessTrail();
    Assert.Equal("Added the integration “Relay” with no role, owned by Sam", trail[0].What);
    Assert.Equal("The desk gives it its role", trail[0].Reason);
    var line = IntegrationLines()[0];
    Assert.Equal("", line.Roles);
    Assert.False(line.HoldsRole);
    Assert.Equal("Say which role the integration holds in that organisation — or leave the organisation out to add it holding no role.",
                 Assert.Throws<ValidationException>(() => AddIntegration("Acme relay", organization: acme)).Message);
    Assert.Equal(1, Integration.Count());
    Assert.Equal(1, AccessChange.Count(c => c.Kind == AccessChangeKind.IntegrationAdded));
    GrantRole(relay, AppRole.Agent);
    var given = IntegrationLines()[0];
    Assert.Equal("Agent", given.Roles);
    Assert.True(given.HoldsRole);
  }
}
