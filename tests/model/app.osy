// Everything this app writes about its people: its roles, who looks after them, and how its roles read.
using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.Organizations;
using Osysharp.UserManagement;

[Role] enum AppRole { Authenticator, Agent, Lead, Admin, Integration, TeamLead, Auditor, Billing, Founder, Vault }

policy IsAdmin => RoleGrant.Any(g => g.Member == user && g.Role == AppRole.Admin);
policy ManagesPeople => IsAdmin;
// Who invites comes from a TABLE — a role's permissions, kept as rows — not only from a role the caller holds. The kit
// asks the server for the answer (`MayInvitePeople()`), so a policy that reads a table works where a control needs it.
policy MayInvite => IsAdmin || RoleGrant.Any(g => g.Member == user && RolePermission.Any(p => p.Role == g.Role && p.Permission == Permission.InvitePeople));

policy IsLead => RoleGrant.Any(g => g.Member == user && g.Role == AppRole.Lead);
/// Who reaches the leads' people page — the admins, and the leads.
policy SeesPeople => IsAdmin || IsLead;

/// What a role may do beyond what the role itself says — a permission handed to a role as a row.
enum Permission { InvitePeople }

/// One permission held by one role. Every signed-in person reads them (they say what a role means); admins change them.
entity RolePermission {
  AppRole Role;
  Permission Permission;
  security { allow read when IsAuthenticated; allow create, update, delete when IsAdmin; }
}
policy ManagesOrganizations => IsAdmin;

app.Accounts = new AccountsSetup { AppName = "People Desk", SignupOpen = false, SecondFactor = new AdminsUseCodes() };

// The integration account's role is the app's own business — never offered, so never handed out by a page.
app.Roles = new RolesSetup { Offered = [
  new RoleChoice { Role = AppRole.Agent, Label = "Agent", Description = "Works the desk." },
  new RoleChoice { Role = AppRole.Lead, Label = "Lead", Description = "Watches the queues." },
  // Held across the app only — never inside a team or a customer.
  new RoleChoice { Role = AppRole.Admin, Label = "Admin", Description = "Runs the desk.", HeldIn = RoleScope.App },
  // Held only inside a team — never an app-wide role (`RoleChoice.HeldIn`).
  new RoleChoice { Role = AppRole.TeamLead, Label = "Team lead", Description = "Leads one team.", HeldIn = RoleScope.Organization },
  // The roles the app's OWN rules below fence (tests/app-rules.test.osy) — offered like any other, so the kit's own
  // checks pass them and only the app's rule can refuse.
  new RoleChoice { Role = AppRole.Auditor, Label = "Auditor", Description = "Reads the books — a person, never a program." },
  new RoleChoice { Role = AppRole.Billing, Label = "Billing", Description = "Changes what customers pay — given only by a founder." },
  new RoleChoice { Role = AppRole.Founder, Label = "Founder", Description = "Started the desk — never taken away." },
  new RoleChoice { Role = AppRole.Vault, Label = "Vault", Description = "Opens the vault — given to nobody, by any route." },
] };

app.People = new PeopleSetup { KeepOneOf = AppRole.Admin };

// The user manager reads who holds which role; every change goes through it, so nothing here grants create or delete.
partial entity RoleGrant {
  security {
    allow read when ManagesPeople;
    // The app's OWN rules on who may hold which role — they bind the user manager's and the invitations' routes as they
    // bind any write (tests/app-rules.test.osy).
    // A person's role, never a program's — said in the app's own words, which is what the manager is told.
    deny create where Role == AppRole.Auditor && (Member is Integration) message "Auditor is a person's role — an integration is never given it.";
    deny create when !IsFounder where Role == AppRole.Billing;              // only a founder hands it out
    deny delete where Role == AppRole.Founder;                              // never taken away
    deny create where Role == AppRole.Vault;                                // nobody, by any route
  }
}

policy IsFounder => RoleGrant.Any(g => g.Member == user && g.Role == AppRole.Founder);

// …and the same within an organisation.
partial entity MembershipRole {
  security {
    deny create where Role == AppRole.Auditor && (Membership.Member is Integration) message "Auditor is a person's role — an integration is never given it.";
    deny create where Role == AppRole.Vault;
  }
}

public class AdminsUseCodes : SecondFactorPolicy {
  public override bool Required(User account) { return RoleGrant.Any(g => g.Member == account && g.Role == AppRole.Admin); }
}

// A small API, so a key issued on the people pages can be presented: who the caller is, as the platform resolved them.
app.Apis = [
  new RestApi("Team") {
    Route = "team",
    Auth = new ApiAuth { ApiKey = true },
    Endpoints = [ new Endpoint(WhoAmI) { Method = HttpMethod.Get, Path = "/me" } ],
    // A customer's rows, as a key held in one customer reads them (tests/integrations.test.osy).
    Expose = [
      new Crud<Customer>() { Operations = [CrudOp.Read] },
      new Crud<CustomerTicket>() { Operations = [CrudOp.Read, CrudOp.Create] },
      new Crud<TicketNote>() { Operations = [CrudOp.Read] },
      new Crud<DeskNotice>() { Operations = [CrudOp.Read] },
    ],
  },
];

/// GET /me — the caller's address.
public string WhoAmI() { return Session.CurrentUser == null ? "" : Session.CurrentUser!.Email; }

/// A team of the app's own people.
entity Team : Organization {
  security { allow read, create, update when IsAdmin; }
}

// ── a customer's own rows — the tenant shape the Organizations kit recommends: every row names its customer, and its
//    members read it (`IsMemberOf`), holders of a role there write it (`HoldsRoleIn`). ────────────────────────────────

policy IsAgent => RoleGrant.Any(g => g.Member == user && g.Role == AppRole.Agent);

/// A customer of the desk. Its own people — and an integration added to it — read it; nobody else but the admins.
entity Customer : Organization {
  security {
    allow read, create, update when IsAdmin;
    allow read when IsAuthenticated where IsMemberOf(this);
  }
}

/// A ticket filed under one customer: read by its members, filed by an agent of that customer.
entity CustomerTicket {
  [Required, Immutable] Customer Customer;
  [MaxLength(200)] string Title = "";
  security {
    allow read, create when IsAdmin;
    allow read when IsAuthenticated where IsMemberOf(Customer);
    allow create when IsAuthenticated where HoldsRoleIn(Customer, AppRole.Agent);
  }
}

/// A note on a ticket — reached only through it, so read as its ticket's customer says.
entity TicketNote {
  [Required, Immutable] CustomerTicket Ticket;
  [MaxLength(500)] string Text = "";
  security {
    allow read, create when IsAdmin;
    allow read when IsAuthenticated where IsMemberOf(Ticket.Customer);
  }
}

/// A notice for the desk's agents across the app — what only an APP-wide Agent reads.
entity DeskNotice {
  [MaxLength(200)] string Text = "";
  security {
    allow read, create when IsAdmin;
    allow read when IsAgent;
  }
}
