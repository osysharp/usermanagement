// The settings area: the kit announces its two pages to whoever looks after the people — beside the
// sections of the other kits this app uses — and to nobody else.

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.UserManagement;

[TestFixture]
void Settings() {
  var lee = new User { Email = "lee@desk.test", DisplayName = "Lee Admin", PasswordHash = Security.HashPassword("correct-horse-1"),
                       EmailVerifiedAt = DateTime.UtcNow, LastLoginAt = DateTime.UtcNow };
  new RoleGrant { Member = lee, Role = AppRole.Admin };
  var kai = new User { Email = "kai@desk.test", DisplayName = "Kai Agent", PasswordHash = Security.HashPassword("correct-horse-2"),
                       EmailVerifiedAt = DateTime.UtcNow };
  new RoleGrant { Member = kai, Role = AppRole.Agent };
}

principal Lee => User.Single(u => u.Email == "lee@desk.test");
principal Kai => User.Single(u => u.Email == "kai@desk.test");

[Test(Settings)]
[runas(Lee)]
void the_kit_announces_its_pages_beside_the_other_kits_sections() {
  var links = AnnouncedSettings();
  Assert.Equal("People", links.Single(l => l.To == "/settings/people").Label);
  Assert.Equal("Access changes", links.Single(l => l.To == "/settings/access").Label);
  Assert.Equal("API keys", links.Single(l => l.To == "/settings/api-keys").Label);
  // The people under "Team"; the trail under "Security" — an auditor's page, not a team page; and the keys where THIS
  // app placed them (`DeskPlacement`, tests/model/pages.osy): a group of its own, ahead of the kit's.
  Assert.Equal("Team", links.Single(l => l.To == "/settings/people").Group);
  Assert.Equal("Security", links.Single(l => l.To == "/settings/access").Group);
  Assert.Equal("Developers", links.Single(l => l.To == "/settings/api-keys").Group);
  Assert.Equal("Developers, Team, Security", string.Join(", ", links.Select(l => l.Group).Distinct()));
}

[Test(Settings)]
void the_settings_nav_lists_each_page_under_the_group_it_was_placed_in() {
  Ui.Viewport(1440, 900);
  Ui.SignInAs(Lee);
  Ui.Visit("/settings/access");
  Assert.Visible("Developers", within: "Settings sections");
  Assert.Visible("Security", within: "Settings sections");
  Assert.Before("Developers", "Team");
  Assert.Before("Team", "Security");
  Assert.Visible("API keys", within: "Settings sections");
  Assert.Visible("No changes yet");
  Ui.Shot("settings-access");
}

[Test(Settings)]
[runas(Kai)]
void nobody_else_is_shown_them() {
  Assert.Equal(0, AnnouncedSettings().Count);
}

[Test(Settings)]
void the_people_page_opens_in_the_settings_frame_and_refuses_anybody_else() {
  Ui.Viewport(1440, 900);
  Ui.SignInAs(Lee);
  Ui.Visit("/settings/people");
  Assert.Visible("People", within: "Settings sections");
  Assert.Visible("Kai Agent", within: "Everyone");
  Ui.SignOut();
  Ui.SignInAs(Kai);
  Ui.Visit("/settings/people");
  Assert.Hidden("Lee Admin");
}
